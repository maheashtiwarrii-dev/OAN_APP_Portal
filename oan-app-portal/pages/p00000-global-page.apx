page 0 (
    name: Global Page

    region legal-footer (
        name: Legal footer
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="u-textCenter" style="font-size:12px;padding:12px 0;">
                  OAN is an independent alumni community and is not affiliated with or endorsed by Oracle Corporation.
                  &middot; <a href="f?p=&APP_ID.:12:&APP_SESSION.">Terms, Privacy &amp; Guidelines</a>
                  &middot; <a href="f?p=&APP_ID.:13:&APP_SESSION.">Report an IP or confidentiality concern</a>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments: NFR-19 disclaimer on every page; FR-19 public takedown link.
        }
    )

    region r0_global_search (
        name: Global search
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="oan-global-search" class="oan-search" role="search" data-url="f?p=&APP_ID.:19:&APP_SESSION.::NO:RP:P19_Q:OANQUERY">
                  <label for="oan-global-search-q" class="u-VisuallyHidden">Search OAN</label>
                  <input id="oan-global-search-q" type="search" maxlength="200" placeholder="Search people, insights, posts" autocomplete="off">
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: beforeNavigationBar
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: sys_context('OAN_CTX','VIEWER_TYPE') = 'MEMBER'
        }
        comments {
            comments: Build Pack §3.2 global search box. Opens page 19 (search results, FR-02); oan-shell.js builds the URL.
        }
    )

    region r0_profile_card (
        name: Profile card
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Build Pack §3.2 profile card; oan-shell.js moves it to the top of the left rail.
                -- Initials only: photos follow the PHOTO section visibility and arrive with W2.
                declare
                    l_html clob;
                begin
                    for s in (select display_name, initials, headline, primary_chapter, completeness
                                from oan_my_shell_v) loop
                        l_html := '<a class="oan-profile-card" href="' || apex_page.get_url(p_page => 23) || '">'
                               || '<span class="oan-avatar" aria-hidden="true">' || apex_escape.html(nvl(s.initials, '?')) || '</span>'
                               || '<span class="oan-pc-text"><span class="oan-pc-name">' || apex_escape.html(s.display_name) || '</span>'
                               || case when s.headline is not null
                                       then '<span class="oan-pc-meta">' || apex_escape.html(s.headline) || '</span>' end
                               || case when s.primary_chapter is not null
                                       then '<span class="oan-pc-meta">' || apex_escape.html(s.primary_chapter) || '</span>' end
                               || case when nvl(s.completeness, 0) < 100
                                       then '<span class="oan-pc-meta">Profile ' || nvl(s.completeness, 0) || '% complete</span>'
                                         || '<span class="oan-pc-meter" aria-hidden="true"><span style="width:'
                                         || nvl(s.completeness, 0) || '%"></span></span>' end
                               || '</span></a>';
                    end loop;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 30
            slot: dialogsDrawersAndPopups
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: sys_context('OAN_CTX','VIEWER_TYPE') = 'MEMBER'
        }
        comments {
            comments: Build Pack §3.2. Shown to approved members only; pending applicants have no rail destinations yet.
        }
    )

    region cookie-notice (
        name: Cookie notice
        type: staticContent
        source {
            htmlCode:
                ```html
                <div id="oan-cookie-notice" class="t-Alert t-Alert--colorBG t-Alert--horizontal t-Alert--info" style="display:none;">
                  <div class="t-Alert-body">OAN Portal uses only essential cookies needed to sign you in and keep your session secure.
                    <a href="f?p=&APP_ID.:12:&APP_SESSION.">Cookie notice</a>.
                    <button type="button" class="t-Button t-Button--small" onclick="localStorage.setItem('oanCookieAck','1');document.getElementById('oan-cookie-notice').style.display='none';">OK</button>
                  </div>
                </div>
                <script>if(!localStorage.getItem('oanCookieAck')){document.getElementById('oan-cookie-notice').style.display='block';}</script>
                ```
        }
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        comments {
            comments: FR-26 / plan 2.11 essential-cookie notice (no consent needed for essential cookies; informational).
        }
    )

)
