page 8 (
    name: Reset Password
    alias: RESET-PASSWORD
    title: Reset your OAN password
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        deepLinking: true
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    comments {
        comments: FR-01 forgot password. Request mode (no token) and reset mode (token from email). Generic responses only (no account enumeration).
    }

    region request-reset (
        name: Forgot your password?
        type: staticContent
        source {
            htmlCode: <p>Enter your account email. If OAN e-mail is switched on, we send a reset link valid for 1 hour. Otherwise ask an OAN administrator for a temporary password.</p>
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P8_TOKEN
        }
    )

    region set-password (
        name: Choose a new password
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P8_TOKEN
        }
    )

    pageItem P8_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 10
            region: @request-reset
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
        sessionState {
            storage: request
        }
    )

    pageItem P8_TOKEN (
        type: hidden
        layout {
            sequence: 10
            region: @set-password
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P8_NEW_PASSWORD (
        type: password
        label {
            label: New password (at least 12 characters)
        }
        layout {
            sequence: 20
            region: @set-password
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
        sessionState {
            storage: request
        }
    )

    button send-link (
        buttonName: SEND_LINK
        label: Send reset link
        layout {
            sequence: 10
            region: @request-reset
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button set-new-password (
        buttonName: SET_PASSWORD
        label: Set new password
        layout {
            sequence: 10
            region: @set-password
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process request-reset (
        name: Request reset
        type: executeCode
        source {
            plsqlCode: oan_auth_pkg.request_password_reset(:P8_EMAIL);
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @send-link
        }
        successMessage {
            successMessage: If an account with a password uses this email, a reset link is on its way.
        }
    )

    process reset (
        name: Reset password
        type: executeCode
        source {
            plsqlCode: oan_auth_pkg.reset_password(p_token => :P8_TOKEN, p_new_password => :P8_NEW_PASSWORD);
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @set-new-password
        }
        successMessage {
            successMessage: Your password was changed. Sign in with your new password.
        }
    )

    branch to-login (
        name: To sign-in page
        behavior {
            type: pageOrUrl
            target: {
                page: 1
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
