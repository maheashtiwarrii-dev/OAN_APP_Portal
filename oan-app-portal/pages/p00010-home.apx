page 10 (
    name: Home
    alias: HOME
    title: OAN Portal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack §3.2 Home (W1) with FR-29: greeting, onboarding checklist, leadership-letter carousel, What's new (announcements + insights), recent community posts. Unread notifications live in the navigation-bar badge. Non-members are routed to their status page.
    }

    region greeting (
        name: Hello, &APP_USER_DISPLAY.
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Build Pack §3.2 personal greeting, in the member's own time zone
                declare
                    l_hour pls_integer;
                begin
                    select to_number(to_char(systimestamp at time zone coalesce(a.timezone, sessiontimezone), 'HH24'))
                      into l_hour
                      from oan_my_account_v a;
                    return '<p>' || case when l_hour < 12 then 'Good morning.'
                                         when l_hour < 18 then 'Good afternoon.'
                                         else 'Good evening.' end
                        || ' Here is what is new across your OAN community.</p>';
                exception
                    when no_data_found then
                        return '<p>Here is what is new across your OAN community.</p>';
                end;
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
    )
    region onboarding (
        name: Get started
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case done when 'Y' then '<span class="fa fa-check-circle u-success-text" aria-hidden="true"></span> '
                                 else '<span class="fa fa-circle-o" aria-hidden="true"></span> ' end
                       || '<a href="' || apex_page.get_url(p_page => link_page) || '">' || apex_escape.html(label) || '</a>' step_html
                  from oan_my_onboarding_v
                 order by sort_order
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery:
                ```sql
                select 1 from oan_my_account_v a
                 where a.onboarding_dismissed = 'N'
                   and exists (select 1 from oan_my_onboarding_v o where o.done = 'N')
                ```
        }

        column STEP_HTML (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Your onboarding checklist
            }
            layout {
                sequence: 1
            }
            security {
                escapeSpecialChars: false
            }
        )

    )

    region r10_leadership_letters (
        name: From OAN leadership
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Build Pack §3.2 leadership-letter carousel: Ink panel, max 6 slides, pause on hover,
                -- pagination dots (oan-shell.js). Text only: no logos or images (Q30).
                declare
                    l_slides clob;
                    l_dots   clob;
                    l_n      pls_integer := 0;
                begin
                    for l in (select title, author_label, summary, post_id from oan_leadership_letters_v order by slide_no) loop
                        l_n := l_n + 1;
                        l_slides := l_slides
                            || '<article class="oan-slide" role="group" aria-roledescription="slide" aria-label="' || l_n || '">'
                            || case when l.author_label is not null
                                    then '<div class="oan-slide-from">' || apex_escape.html(l.author_label) || '</div>' end
                            || '<h3>' || apex_escape.html(l.title) || '</h3>'
                            || '<p>' || apex_escape.html(l.summary) || '</p>'
                            || case when l.post_id is not null
                                    then '<a href="' || apex_page.get_url(p_page => 62, p_items => 'P62_ID', p_values => l.post_id)
                                      || '">Read the letter</a>' end
                            || '</article>';
                        l_dots := l_dots || '<button type="button" class="oan-carousel-dot" aria-label="Show letter ' || l_n || '"></button>';
                    end loop;
                    if l_n = 0 then
                        return null;
                    end if;
                    return '<section class="oan-carousel' || case when l_n = 1 then ' is-static' end
                        || '" aria-roledescription="carousel" aria-label="Letters from OAN leadership" tabindex="0">'
                        || l_slides
                        || case when l_n > 1 then '<div class="oan-carousel-dots">' || l_dots || '</div>' end
                        || '</section>';
                end;
                ```
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_leadership_letters_v
        }
    )

    region r10_upcoming_events (
        name: Upcoming events
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- Build Pack Home: upcoming events strip (W3.3 first slice). Max 6, soonest first.
                declare
                    l_html clob;
                begin
                    for e in (select title, venue, is_online, chapter_name, day_no, month_abbr, when_label
                                from oan_upcoming_events_v order by starts_at fetch first 6 rows only) loop
                        l_html := l_html || '<div class="oan-event"><div class="oan-event-date" aria-hidden="true"><b>'
                            || e.day_no || '</b><span>' || e.month_abbr || '</span></div><div><div class="oan-event-title">'
                            || apex_escape.html(e.title) || '</div><div class="oan-event-meta">'
                            || apex_escape.html(e.when_label) || ' &middot; '
                            || case when e.is_online = 'Y' then 'Online' else apex_escape.html(e.venue) end
                            || case when e.chapter_name is not null then ' &middot; ' || apex_escape.html(e.chapter_name) end
                            || '</div></div></div>';
                    end loop;
                    return case when l_html is not null then '<div class="oan-events-strip">' || l_html || '</div>' end;
                end;
                ```
        }
        layout {
            sequence: 16
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_upcoming_events_v
        }
    )

    region r10_whats_new (
        name: What's new
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select item_kind, kind_label, title, summary,
                       to_char(published_at, 'DD Mon YYYY') published,
                       case when link_value is not null
                            then apex_page.get_url(p_page => link_page, p_items => link_item, p_values => link_value) end link_url
                  from oan_whats_new_v
                 order by published_at desc
                 fetch first 12 rows only
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Nothing new yet. Announcements and new insights will appear here.
        }
        comments {
            comments: Build Pack §3.2 "What's new": announcements and Library insights by recency (oan_whats_new_v). Events join when W3 lands.
        }

        column ITEM_KIND (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column KIND_LABEL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 2
            }
        )

        column TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            type: link
            heading {
                heading: Title
            }
            layout {
                sequence: 3
            }
            link {
                target: {
                    type: url
                    url: #LINK_URL#
                }
                linkText: #TITLE#
            }
        )

        column SUMMARY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Summary
            }
            layout {
                sequence: 4
            }
        )

        column PUBLISHED (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Published
            }
            layout {
                sequence: 5
            }
        )

        column LINK_URL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: hidden
            layout {
                sequence: 6
            }
        )

    )
    region recent-discussions (
        name: Recent posts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, group_name, author_name, to_char(last_activity_at, 'DD Mon HH24:MI') last_activity, comment_count
                  from oan_posts_v
                 where group_visibility = 'OPEN'
                 order by last_activity_at desc
                 fetch first 6 rows only
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No posts yet. Start one from the Groups page.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Post
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 62
                    items: {
                        P62_ID: \#ID#\
                    }
                }
                linkText: #TITLE#
            }
        )

        column GROUP_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Group
            }
            layout {
                sequence: 3
            }
        )

        column AUTHOR_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Posted by
            }
            layout {
                sequence: 4
            }
        )

        column LAST_ACTIVITY (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Last activity
            }
            layout {
                sequence: 5
            }
        )

        column COMMENT_COUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Comments
            }
            layout {
                sequence: 6
            }
        )

    )

    button dismiss-onboarding (
        buttonName: DISMISS_ONBOARDING
        label: Hide checklist
        layout {
            sequence: 10
            region: @onboarding
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process dismiss-onboarding (
        name: Dismiss onboarding
        type: executeCode
        source {
            plsqlCode: oan_profile_pkg.dismiss_onboarding;
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @dismiss-onboarding
        }
    )

    branch route-applicants (
        name: Route non-members to their status page
        behavior {
            type: functionReturningUrl
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- Verified but not yet applied: the onboarding conversation (2) first, then the application (6)
                for a in (select status from oan_my_account_v) loop
                    if a.status = 'PENDING_REGISTRATION' then
                        if nvl(oan_chat_pkg.current_step, 'WELCOME') != 'DONE' then
                            return apex_page.get_url(p_page => 2);
                        end if;
                        return apex_page.get_url(p_page => 6);
                    end if;
                end loop;
                return apex_page.get_url(p_page => 5);
                ```
        }
        execution {
            point: beforeHeader
            sequence: 10
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: nvl(sys_context('OAN_CTX','VIEWER_TYPE'), 'NONE') = 'PENDING'
        }
    )

    branch route-journey (
        name: Route a newly approved member to their onboarding journey
        behavior {
            type: functionReturningUrl
            language: plsql
            plsqlFunctionBody:
                ```plsql
                -- First login after approval only (R21); journeys whose wave is not live stay on Home (R05)
                return apex_page.get_url(p_page => oan_chat_pkg.landing_page_after_approval);
                ```
        }
        execution {
            point: beforeHeader
            sequence: 20
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: sys_context('OAN_CTX','VIEWER_TYPE') = 'MEMBER' and oan_chat_pkg.pending_journey_page is not null
        }
    )

)
