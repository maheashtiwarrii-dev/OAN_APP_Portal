page 13 (
    name: Report Concern
    alias: REPORT-CONCERN
    title: Report an IP or confidentiality issue
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        deepLinking: true
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: FR-19 item 4 notice-and-takedown, usable without login. Throttled 5/IP/day; triage-first (Q19).
    }

    region concern (
        name: Report an IP or confidentiality concern
        type: staticContent
        source {
            htmlCode: <p>Tell us which Library item concerns you and why. A moderator reviews every report; untriaged items are hidden automatically after one business day.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P13_ITEM_ID (
        type: popupLov
        label {
            label: Library item
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select title d, id r from oan_public_library_ref_v order by title
                ```
        }
        layout {
            sequence: 10
            region: @concern
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P13_REASON (
        type: selectList
        label {
            label: Concern
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Confidential information;CONFIDENTIAL,Copyright or licence;COPYRIGHT,Personal data;PERSONAL_DATA,Other;OTHER
        }
        layout {
            sequence: 20
            region: @concern
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P13_DETAILS (
        type: textarea
        label {
            label: Details
        }
        layout {
            sequence: 30
            region: @concern
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 4000
        }
    )

    pageItem P13_EMAIL (
        type: textField
        label {
            label: Your email (optional, for follow-up)
        }
        layout {
            sequence: 40
            region: @concern
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
    )

    pageItem P13_WEBSITE (
        type: textField
        label {
            label: Leave this field empty
        }
        layout {
            sequence: 50
            region: @concern
            slot: regionBody
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            cssClasses: u-VisuallyHidden
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit report
        layout {
            sequence: 10
            region: @concern
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process report (
        name: File IP report
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    if :P13_WEBSITE is null then
                        l_id := oan_library_pkg.report_ip(:P13_ITEM_ID, :P13_REASON, :P13_DETAILS, :P13_EMAIL);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        successMessage {
            successMessage: Thank you. Your report was received and will be reviewed.
        }
    )

    process clear (
        name: Clear form
        type: clearSessionState
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)
