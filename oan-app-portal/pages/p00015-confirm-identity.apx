page 15 (
    name: Confirm Identity
    alias: CONFIRM-IDENTITY
    title: Confirm your identity
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: NFR-01 re-authentication gate (export, deletion, email/password change, Members+Partners visibility, role grants). Valid 5 minutes for this session.
    }

    region with-password (
        name: Confirm with your password
        type: staticContent
        source {
            htmlCode: <p>For your security, confirm your identity before continuing.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_account_v where has_local_password > 0
        }
    )

    region with-provider (
        name: Confirm with your sign-in provider
        type: staticContent
        source {
            htmlCode: <p>Your account has no password yet. Set one from the sign-in page with "Forgot password", then confirm your identity here.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_account_v where linked_providers is not null
        }
    )

    pageItem P15_PASSWORD (
        type: password
        label {
            label: Password
        }
        layout {
            sequence: 10
            region: @with-password
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
        sessionState {
            storage: request
        }
    )

    button confirm-password (
        buttonName: CONFIRM_PASSWORD
        label: Confirm
        layout {
            sequence: 10
            region: @with-password
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process verify-password (
        name: Verify password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if not oan_auth_pkg.reauth_local(:P15_PASSWORD) then
                    raise_application_error(-20401, 'That password is not correct.');
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @confirm-password
        }
    )

    branch back-to-caller (
        name: Back to the calling page
        behavior {
            type: functionReturningUrl
            language: plsql
            plsqlFunctionBody: return apex_page.get_url(p_page => coalesce(to_number(:REAUTH_RETURN_PAGE), 1));
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @confirm-password
        }
    )

)
