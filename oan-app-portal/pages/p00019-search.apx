page 19 (
    name: Search
    alias: SEARCH
    title: Search
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        deepLinking: true
        authorizationScheme: @is-active
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    comments {
        comments: Build Pack page 19 Global search results (FR-02). The page 0 search box opens this page with P19_Q in the URL, so the page and item are unrestricted; P19_Q is only ever bound, never concatenated. Results come from OAN_SEARCH_PKG.SEARCH, which filters through the secure views (members: name and headline only, P31): library, insights, open-group posts, members, opportunities, events, groups, trainings and initiatives (W1.3); never messages or private-group posts (R20).
    }

    region search (
        name: Search OAN
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region results (
        name: Results
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select case s.result_type when 'LIBRARY' then 'Library'
                                          when 'INSIGHT' then 'Insight'
                                          when 'POST'    then 'Discussion'
                                          when 'OPPORTUNITY' then 'Opportunity'
                                          when 'EVENT'   then 'Event'
                                          when 'GROUP'   then 'Group'
                                          when 'TRAINING' then 'Training'
                                          when 'INITIATIVE' then 'Initiative'
                                          else 'Member' end type_label,
                       s.title,
                       s.snippet,
                       apex_page.get_url(
                           p_page   => s.link_page,
                           p_items  => case s.result_type when 'LIBRARY' then 'P35_ID'
                                                          when 'INSIGHT' then 'P31_ID'
                                                          when 'POST'    then 'P62_ID'
                                                          when 'OPPORTUNITY' then 'P51_ID'
                                                          when 'EVENT'   then 'P33_EVENT_ID'
                                                          when 'GROUP'   then 'P61_ID'
                                                          when 'INITIATIVE' then 'P77_ID'
                                                          when 'TRAINING' then null
                                                          else 'P22_USER_ID' end,
                           p_values => case when s.result_type != 'TRAINING' then to_char(s.object_id) end) link_url
                  from table(oan_search_pkg.search(:P19_Q)) s
                 order by s.score desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Nothing matched. Try fewer or different words, or browse the alumni directory.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P19_Q
        }

        column TYPE_LABEL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Result
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    type: url
                    url: #LINK_URL#
                }
                linkText: #TITLE#
            }
        )

        column SNIPPET (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Details
            }
            layout {
                sequence: 3
            }
        )

        column LINK_URL (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

    )

    pageItem P19_Q (
        type: textField
        label {
            label: Search people, insights and discussions
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 10
            region: @search
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button directory (
        buttonName: DIRECTORY
        label: Alumni directory
        layout {
            sequence: 20
            region: @search
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
