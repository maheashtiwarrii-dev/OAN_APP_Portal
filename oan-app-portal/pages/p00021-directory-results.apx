page 21 (
    name: Directory Results
    alias: DIRECTORY-RESULTS
    title: Alumni directory
    appearance {
        pageTemplate: @/left-side-column
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack page 21 Directory results (FR-35 AC1-AC3, W2.5). Faceted search over OAN_DIRECTORY_V only, read through OAN_DIRECTORY_SEARCH_PKG.DIRECTORY_ROWS (faceted search wraps queries in WITH clauses, which the OAN_VIS SQL macros do not allow, ORA-64630). Every facet value is already masked by its section level, so filtering cannot reveal a hidden value. Missing values show as a dash (FSD BR-05). Availability is CAREER_STATUS-masked (connections only by default, R13), so members only filter on what they may see.
    }

    region button-bar (
        name: Button Bar
        type: staticContent
        source {
            htmlCode: <div id="active_facets"></div>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noPadding
                t-ButtonRegion--noUI
            ]
        }
    )

    region people (
        name: People
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.user_id,
                       d.display_name,
                       coalesce(d.initials, '?') initials,
                       case when d.photo_file_id is not null
                            then 'f?p=' || :APP_ID || ':1:' || :APP_SESSION || ':APPLICATION_PROCESS=OAN_PHOTO:::OAN_PHOTO_ID:' || d.photo_file_id end photo_url,
                       coalesce(d.job_title, '—') || ' · ' || coalesce(d.current_org, '—') role_org,
                       coalesce(d.location_name, '—') || ' · ' || coalesce(d.primary_chapter, '—') where_text,
                       coalesce(d.skills, '—') skills_text,
                       d.headline,
                       d.job_title,
                       d.current_org,
                       d.location_name,
                       d.skill_list,
                       d.chapter_list,
                       d.oracle_tenure,
                       d.industry_list,
                       d.language_list,
                       d.availability,
                       'oan-av-' || mod(d.user_id, 6) av_class,
                       coalesce(d.availability, d.job_title, d.headline, '—') line2,
                       d.current_org org_text,
                       case when coalesce(d.location_name, d.primary_chapter) is not null
                            then '◦ ' || coalesce(d.location_name, d.primary_chapter) end loc_text,
                       case when d.total_exp_years is not null then d.total_exp_years || ' yrs' else '—' end total_exp,
                       nvl(d.oracle_years, '—') oracle_years,
                       nvl(to_char(d.follower_count), '—') followers,
                       case when d.i_follow > 0 then 'Following' else 'Follow' end follow_label
                  from table(oan_directory_search_pkg.directory_rows) d
                ```
        }
        orderBy {
            type: item
            item: {
                itemName: P21_ORDER_BY
                orderBys: {
                    NAME: "DISPLAY_NAME" asc
                    ORG: "CURRENT_ORG" asc nulls last, "DISPLAY_NAME" asc
                }
            }
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: USER_ID
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="oan-dcard-top"><span class="oan-dcard-avatar &AV_CLASS!ATTR." aria-hidden="true">{if ?PHOTO_URL/}<img src="&PHOTO_URL!ATTR." alt="">{else/}&INITIALS!HTML.{endif/}</span><span><span class="oan-dcard-name" style="display:block">&DISPLAY_NAME!HTML.</span><span class="oan-dcard-line" style="display:block">&LINE2!HTML.</span><span class="oan-dcard-org" style="display:block">&ORG_TEXT!HTML.</span><span class="oan-dcard-loc" style="display:block">&LOC_TEXT!HTML.</span></span></span>
                ```
        }
        body {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="oan-dcard-stats"><div><span>Total exp.</span><b>&TOTAL_EXP!HTML.</b></div><div><span>Oracle tenure</span><b>&ORACLE_YEARS!HTML.</b></div><div><span>Followers</span><b>&FOLLOWERS!HTML.</b></div></div>
                ```
        }
        messages {
            whenNoDataFound: Nobody matches these filters. Try fewer filters or a shorter search.
        }
        componentAppearance {
            layout: grid
            gridColumns: 3
        }

        action open-profile (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 22
                    items: {
                        P22_USER_ID: &USER_ID.
                    }
                    clearCache: 22
                    request: DIR
                }
            }
        )

        action follow (
            type: button
            label: &FOLLOW_LABEL.
            layout {
                sequence: 20
                position: primary
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 21
                    items: {
                        P21_FOLLOW_ID: &USER_ID.
                    }
                    request: FOLLOW_TOGGLE
                }
            }
            appearance {
                displayType: text
                hot: true
            }
        )

        action message (
            type: button
            label: Message
            layout {
                sequence: 30
                position: primary
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 40
                    items: {
                        P40_TO_USER: &USER_ID.
                    }
                    request: START
                }
            }
            appearance {
                displayType: text
                hot: false
            }
        )
    )

    region search (
        name: Search
        type: facetedSearch
        source {
            filteredRegion: @people
        }
        layout {
            sequence: 10
            slot: leftColumn
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--scrollBody
            ]
        }
        settings {
            showCurrentFacets: selector
            currentFacetsSelector: #active_facets
            showTotalRowCount: true
            totalRowCountLabel: Members found
        }

        facet P21_SEARCH (
            type: search
            label {
                label: Search
            }
            layout {
                sequence: 10
            }
            source {
                dbColumns: DISPLAY_NAME,HEADLINE,JOB_TITLE,CURRENT_ORG,SKILLS_TEXT
            }
        )

        facet P21_SKILL (
            type: checkboxGroup
            label {
                label: Skill
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 20
            }
            listEntries {
                maxDisplayedEntries: 10
            }
            source {
                databaseColumn: SKILL_LIST
                dataType: varchar2
            }
            multipleValues {
                type: delimitedList
                separator: |
                trimWhitespace: true
                filterCombination: and
            }
        )

        facet P21_ORG (
            type: checkboxGroup
            label {
                label: Current organisation
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 30
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: CURRENT_ORG
                dataType: varchar2
            }
        )

        facet P21_LOCATION (
            type: checkboxGroup
            label {
                label: Location
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 40
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: LOCATION_NAME
                dataType: varchar2
            }
        )

        facet P21_CHAPTER (
            type: checkboxGroup
            label {
                label: Chapter
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 50
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: CHAPTER_LIST
                dataType: varchar2
            }
            multipleValues {
                type: delimitedList
                separator: |
                trimWhitespace: true
                filterCombination: or
            }
        )

        facet P21_TENURE (
            type: checkboxGroup
            label {
                label: Years at Oracle
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: ORACLE_TENURE
                dataType: varchar2
            }
        )

        facet P21_INDUSTRY (
            type: checkboxGroup
            label {
                label: Industry expertise
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 70
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: INDUSTRY_LIST
                dataType: varchar2
            }
            multipleValues {
                type: delimitedList
                separator: |
                trimWhitespace: true
                filterCombination: or
            }
        )

        facet P21_LANGUAGE (
            type: checkboxGroup
            label {
                label: Language
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 80
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: LANGUAGE_LIST
                dataType: varchar2
            }
            multipleValues {
                type: delimitedList
                separator: |
                trimWhitespace: true
                filterCombination: or
            }
        )

        facet P21_AVAILABILITY (
            type: checkboxGroup
            label {
                label: Open to opportunities
            }
            lov {
                type: distinctValues
            }
            layout {
                sequence: 90
            }
            listEntries {
                maxDisplayedEntries: 7
            }
            source {
                databaseColumn: AVAILABILITY
                dataType: varchar2
            }
        )

    )

    pageItem P21_ORDER_BY (
        type: selectList
        label {
            label: Sort by
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Name;NAME,Organisation;ORG
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @people
            slot: sortOrder
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        advanced {
            warnOnUnsavedChanges: ignore
        }
        default {
            type: static
            staticValue: NAME
        }
        security {
            sessionStateProtection: unrestricted
        }
    )


    pageItem P21_FOLLOW_ID (
        type: hidden
        layout {
            sequence: 50
            region: @button-bar
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    process follow-toggle (
        name: Follow or unfollow from a card
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_following number;
                begin
                    select i_follow into l_following from oan_directory_v where user_id = to_number(:P21_FOLLOW_ID);
                    if l_following > 0 then
                        oan_network_pkg.unfollow(to_number(:P21_FOLLOW_ID));
                    else
                        oan_network_pkg.follow(to_number(:P21_FOLLOW_ID));
                    end if;
                    -- faceted search keeps its filters in session state, so the same results come back
                    apex_util.redirect_url(apex_page.get_url(p_page => 21));
                exception
                    when no_data_found then
                        raise_application_error(-20403, 'That member was not found.');
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: FOLLOW_TOGGLE
        }
    )

    process kpi-search (
        name: Count a directory search (S31, aggregate only)
        type: executeCode
        source {
            plsqlCode: oan_kpi_pkg.bump('DIRECTORY_SEARCH');
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: :REQUEST is null or :REQUEST != 'FOLLOW_TOGGLE'
        }
    )
)
