            sequence: 70
            region: @network
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Remove this member from your connections?
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P22_CONN_STATUS
            value: CONNECTED
        }
    )

    button block (
        buttonName: BLOCK
        label: Block
        layout {
            sequence: 80
            region: @network
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Block this member? You will no longer see each other, and any connection or follow between you is removed.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P22_CONN_STATUS
        }
    )

    button report (
        buttonName: REPORT
        label: Report this profile
        layout {
            sequence: 10
            region: @profile
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                clearCache: 80
                items: {
                    P80_OBJECT_TYPE: PROFILE
                    P80_OBJECT_ID: &P22_USER_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load-relationship (
        name: Load relationship
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P22_CONN_STATUS := null;
                :P22_I_FOLLOW    := null;
                for r in (select connection_status, connection_id, i_follow, accepts_followers, mutual_count
                            from oan_relationship_v where user_id = :P22_USER_ID) loop
                    :P22_CONN_STATUS   := r.connection_status;
                    :P22_CONNECTION_ID := r.connection_id;
                    -- no Follow button when the member does not accept followers
                    :P22_I_FOLLOW      := case when r.i_follow = 'N' and r.accepts_followers = 'N' then null else r.i_follow end;
                    :P22_NETWORK_TEXT  := case r.connection_status
                                              when 'CONNECTED'   then 'You are connected.'
                                              when 'PENDING_OUT' then 'Your connection request is waiting for a reply.'
                                              when 'PENDING_IN'  then 'This member asked to connect with you.'
                                              else 'You are not connected yet.'
                                          end
                                          || case when r.mutual_count > 0 then ' Mutual connections: ' || r.mutual_count || '.' end;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process network-action (
        name: Networking action
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'CONNECT'           then oan_network_pkg.request_connection(:P22_USER_ID, :P22_NOTE);
                    when 'ACCEPT'            then oan_network_pkg.accept_connection(:P22_CONNECTION_ID);
                    when 'DECLINE'           then oan_network_pkg.reject_connection(:P22_CONNECTION_ID);
                    when 'WITHDRAW'          then oan_network_pkg.withdraw_connection(:P22_CONNECTION_ID);
                    when 'FOLLOW'            then oan_network_pkg.follow(:P22_USER_ID);
                    when 'UNFOLLOW'          then oan_network_pkg.unfollow(:P22_USER_ID);
                    when 'REMOVE_CONNECTION' then oan_network_pkg.remove_connection(:P22_USER_ID);
                    when 'BLOCK'             then oan_network_pkg.block_member(:P22_USER_ID);
                end case;
                :P22_NOTE := null;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CONNECT,ACCEPT,DECLINE,WITHDRAW,FOLLOW,UNFOLLOW,REMOVE_CONNECTION,BLOCK
        }
        successMessage {
            successMessage: Done.
        }
    )

    branch after-block (
        name: To connections after a block
        behavior {
            type: pageOrUrl
            target: {
                page: 28
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @block
        }
    )

    branch back-to-profile (
        name: Back to this profile
        behavior {
            type: pageOrUrl
            target: {
                page: 22
                items: {
                    P22_USER_ID: &P22_USER_ID.
                }
            }
        }
        execution {
            point: afterProcessing
            sequence: 20
        }
    )

)
