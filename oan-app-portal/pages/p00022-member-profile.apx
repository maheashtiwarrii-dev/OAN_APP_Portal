            sqlQuery:
                ```sql
                select organisation, title, period, description
                  from oan_profile_experience_v
                 where user_id = :P22_USER_ID
                 order by start_year desc
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Not shared with you, or nothing added yet.
        }

        column ORGANISATION (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Organisation
            }
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Title
            }
            layout {
                sequence: 2
            }
        )

        column PERIOD (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Years
            }
            layout {
                sequence: 3
            }
        )

        column DESCRIPTION (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Details
            }
            layout {
                sequence: 4
            }
        )

    )

    region education (
        name: Education
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select institution, qualification, field_of_study, period
                  from oan_profile_education_v
                 where user_id = :P22_USER_ID
                 order by end_year desc nulls first
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Not shared with you, or nothing added yet.
        }

        column INSTITUTION (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Institution
            }
            layout {
                sequence: 1
            }
        )

        column QUALIFICATION (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Qualification
            }
            layout {
                sequence: 2
            }
        )

        column FIELD_OF_STUDY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Field
            }
            layout {
                sequence: 3
            }
        )

        column PERIOD (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Years
            }
            layout {
                sequence: 4
            }
        )

    )

    region certifications (
        name: Certifications and achievements
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select kind_label, name, issuer, year_obtained
                  from oan_profile_certifications_v
                 where user_id = :P22_USER_ID
                 order by year_obtained desc nulls last
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Not shared with you, or nothing added yet.
        }

        column KIND_LABEL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 1
            }
        )

        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Name
            }
            layout {
                sequence: 2
            }
        )

        column ISSUER (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Issued by
            }
            layout {
                sequence: 3
            }
        )

        column YEAR_OBTAINED (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Year
            }
            layout {
                sequence: 4
            }
        )

    )

    region terms (
        name: Languages, industries and interests
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select listagg(case when term_kind = 'LANGUAGE' then name end, ', ') within group (order by name) languages,
                       listagg(case when term_kind = 'INDUSTRY' then name end, ', ') within group (order by name) industries,
                       listagg(case when term_kind = 'INTEREST' then name end, ', ') within group (order by name) interests
                  from oan_profile_terms_v
                 where user_id = :P22_USER_ID
                having count(*) > 0
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/value-attribute-pairs-column
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Not shared with you, or nothing added yet.
        }

        column LANGUAGES (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Languages
            }
            layout {
                sequence: 1
            }
        )

        column INDUSTRIES (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Industry expertise
            }
            layout {
                sequence: 2
            }
        )

        column INTERESTS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Interests
            }
            layout {
                sequence: 3
            }
        )

    )

    pageItem P22_USER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @profile
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button report (
        buttonName: REPORT
        label: Report this profile
        layout {
            sequence: 10
            region: @profile
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                clearCache: 80
                items: {
                    P80_OBJECT_TYPE: PROFILE
                    P80_OBJECT_ID: &P22_USER_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
