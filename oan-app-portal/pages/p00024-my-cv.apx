page 24 (
    name: My CV
    alias: MY-CV
    title: My CV
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack page 24 My CV (FR-47, R13; W2.6/W2.7/W2.11). Upload PDF/DOCX (last 3 versions, one current), confirm it is still current, structured CV sections with a printable view (browser print or save as PDF; server PDF behind CV_PDF), share the current CV with one connection at a time (expires after CV_SHARE_DAYS, revocable, audited) and open CVs connections shared with you. Downloads go through OAN_DOWNLOAD_V.
    }

    region r24_update_request (
        name: Is your CV still current?
        type: staticContent
        source {
            htmlCode: <p>It has been a while since you uploaded or confirmed your CV. Upload a newer version below, or keep the one you have.</p>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--warning
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_update_requests_v where request_type = 'CV'
        }
    )

    region upload (
        name: Upload your CV
        type: staticContent
        source {
            htmlCode: <p>Upload a PDF or Word (.docx) file up to 20 MB. The newest upload becomes your current CV, and the last three versions are kept. Your CV is private: only you, and connections you share it with, can open it.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region versions (
        name: Your CV versions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, file_id, filename, status_label, size_kb, uploaded_at, is_current,
                       'Download' download_label, 'Make current' current_label, 'Delete' delete_label
                  from oan_my_cvs_v
                 order by uploaded_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: You have not uploaded a CV yet.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column FILE_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column FILENAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: File
            }
            layout {
                sequence: 3
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 4
            }
        )

        column SIZE_KB (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Size (KB)
            }
            layout {
                sequence: 5
            }
        )

        column UPLOADED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Uploaded
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
        )

        column IS_CURRENT (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column DOWNLOAD_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Download
            }
            layout {
                sequence: 8
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_FILE_ID: \#FILE_ID#\
                    }
                    request: DOWNLOAD
                }
                linkText: #DOWNLOAD_LABEL#
            }
        )

        column CURRENT_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: link
            heading {
                heading: Use
            }
            layout {
                sequence: 9
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_CV_ID: \#ID#\
                    }
                    request: MAKE_CURRENT
                }
                linkText: #CURRENT_LABEL#
            }
        )

        column DELETE_LABEL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Remove
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_CV_ID: \#ID#\
                    }
                    request: DELETE_CV
                }
                linkText: #DELETE_LABEL#
            }
        )

    )

    region r24_sections (
        name: Structured CV
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, section_label, nvl(title, section_label) title,
                       substr(content, 1, 160) || case when length(content) > 160 then '...' end preview,
                       sort_order, 'Edit' edit_label, 'Delete' delete_label
                  from oan_my_cv_sections_v
                 order by section_code, sort_order, id
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Add a summary, highlights or projects. Your experience, education, certifications, skills and languages come from your profile automatically.
        }
        comments {
            comments: W2.6 structured CV. Sections the member writes; profile entries are added by oan_cv_pkg.cv_html.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column SECTION_LABEL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Section
            }
            layout {
                sequence: 2
            }
        )

        column TITLE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Title
            }
            layout {
                sequence: 3
            }
        )

        column PREVIEW (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Text
            }
            layout {
                sequence: 4
            }
        )

        column SORT_ORDER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Order
            }
            layout {
                sequence: 5
            }
        )

        column EDIT_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: link
            heading {
                heading: Edit
            }
            layout {
                sequence: 6
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_SECTION_ID: \#ID#\
                    }
                    request: EDIT_SECTION
                }
                linkText: #EDIT_LABEL#
            }
        )

        column DELETE_LABEL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Remove
            }
            layout {
                sequence: 7
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_SECTION_ID: \#ID#\
                    }
                    request: DELETE_SECTION
                }
                linkText: #DELETE_LABEL#
            }
        )

    )

    region r24_section_form (
        name: Add or edit a section
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region r24_preview (
        name: Printable CV
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                -- W2.6: escaped HTML built from the profile and the sections. Browser print keeps only .oan-cv
                -- (print stylesheet in oan-shell.css), so "Save as PDF" gives a clean CV.
                return '<p><button type="button" class="t-Button t-Button--hot" onclick="window.print()">Print or save as PDF</button></p>'
                    || oan_cv_pkg.cv_html;
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region r24_share (
        name: Share your current CV
        type: staticContent
        source {
            htmlCode: <p>Share your current CV with one connection at a time, for example for a referral. The share ends after 30 days, and you can revoke it at any time. Every share is logged.</p>
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_cvs_v where is_current = 'Y'
        }
    )

    region r24_my_shares (
        name: Who can see your CV
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, member_name, filename, purpose, status_label, shared_at, expires_at,
                       case when status_label = 'Active' then 'Revoke' end revoke_label
                  from oan_my_cv_shares_v
                 order by shared_at desc
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: You have not shared your CV with anyone.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column MEMBER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Shared with
            }
            layout {
                sequence: 2
            }
        )

        column FILENAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: File
            }
            layout {
                sequence: 3
            }
        )

        column PURPOSE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Purpose
            }
            layout {
                sequence: 4
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 5
            }
        )

        column SHARED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Shared
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column EXPIRES_AT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Ends
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column REVOKE_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Revoke
            }
            layout {
                sequence: 8
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_SHARE_ID: \#ID#\
                    }
                    request: REVOKE_SHARE
                }
                linkText: #REVOKE_LABEL#
            }
        )

    )

    region r24_shared_with_me (
        name: CVs shared with you
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select file_id, owner_name, headline, filename, purpose, expires_at, 'Download' download_label
                  from oan_cvs_shared_with_me_v
                 order by shared_at desc
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No connection has shared a CV with you.
        }

        column FILE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column OWNER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Member
            }
            layout {
                sequence: 2
            }
        )

        column HEADLINE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 3
            }
        )

        column FILENAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: File
            }
            layout {
                sequence: 4
            }
        )

        column PURPOSE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Purpose
            }
            layout {
                sequence: 5
            }
        )

        column EXPIRES_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Available until
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column DOWNLOAD_LABEL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Download
            }
            layout {
                sequence: 7
            }
            link {
                target: {
                    page: 24
                    items: {
                        P24_FILE_ID: \#FILE_ID#\
                    }
                    request: DOWNLOAD
                }
                linkText: #DOWNLOAD_LABEL#
            }
        )

    )

    pageItem P24_CV (
        type: fileUpload
        label {
            label: CV file (PDF or Word .docx, max 20 MB)
        }
        display {
            displayAs: inlineDropzone
        }
        storage {
            type: appTempFiles
            purgeFileAt: endOfRequest
            fileTypes: application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
            maxFileSize: 20480
        }
        layout {
            sequence: 10
            region: @upload
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_FILE_ID (
        type: hidden
        layout {
            sequence: 20
            region: @upload
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P24_CV_ID (
        type: hidden
        layout {
            sequence: 30
            region: @upload
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P24_SHARE_ID (
        type: hidden
        layout {
            sequence: 40
            region: @upload
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P24_SECTION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @r24_section_form
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P24_SECTION_VER (
        type: hidden
        layout {
            sequence: 20
            region: @r24_section_form
            slot: regionBody
        }
    )

    pageItem P24_SECTION_CODE (
        type: selectList
        label {
            label: Section
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Summary;SUMMARY,Highlights;HIGHLIGHTS,Projects;PROJECTS,Other;OTHER
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 30
            region: @r24_section_form
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_SECTION_TITLE (
        type: textField
        label {
            label: Title (optional)
        }
        layout {
            sequence: 40
            region: @r24_section_form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P24_SECTION_SORT (
        type: numberField
        label {
            label: Order
        }
        default {
            type: static
            staticValue: 10
        }
        layout {
            sequence: 50
            region: @r24_section_form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_SECTION_CONTENT (
        type: textarea
        label {
            label: Text
        }
        layout {
            sequence: 60
            region: @r24_section_form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P24_SHARE_MEMBER (
        type: selectList
        label {
            label: Connection
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_name d, user_id r from oan_my_connections_v order by display_name
                ```
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 10
            region: @r24_share
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P24_SHARE_PURPOSE (
        type: textField
        label {
            label: Purpose (optional, for example a referral)
        }
        layout {
            sequence: 20
            region: @r24_share
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 300
        }
    )

    button keep-current (
        buttonName: KEEP_CURRENT
        label: Keep my current CV
        layout {
            sequence: 10
            region: @r24_update_request
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button upload (
        buttonName: UPLOAD
        label: Upload CV
        layout {
            sequence: 10
            region: @upload
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirm-cv (
        buttonName: CONFIRM_CV
        label: My current CV is still current
        layout {
            sequence: 15
            region: @upload
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_cvs_v where is_current = 'Y'
        }
    )

    button back (
        buttonName: BACK
        label: Back to my profile
        layout {
            sequence: 20
            region: @upload
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 23
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-section (
        buttonName: SAVE_SECTION
        label: Save section
        layout {
            sequence: 10
            region: @r24_section_form
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button new-section (
        buttonName: NEW_SECTION
        label: New section
        layout {
            sequence: 20
            region: @r24_section_form
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 24
                clearCache: 24
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button share (
        buttonName: SHARE
        label: Share CV
        layout {
            sequence: 10
            region: @r24_share
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process download-cv (
        name: Download CV
        type: download
        fileHandling {
            multipleFiles: false
            viewFileAs: attachment
        }
        source {
            sqlQuery:
                ```sql
                select content, filename, mime_type from oan_download_v where file_id = :P24_FILE_ID
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD
        }
    )

    process make-current (
        name: Make CV current
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_cv_pkg.make_current(:P24_CV_ID);
                -- drop the request from the URL so a reload does not repeat the action
                apex_util.redirect_url(apex_page.get_url(p_page => 24));
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: MAKE_CURRENT
        }
    )

    process delete-cv (
        name: Delete CV version
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_cv_pkg.delete_cv(:P24_CV_ID);
                -- drop the request from the URL so a reload does not repeat the action
                apex_util.redirect_url(apex_page.get_url(p_page => 24));
                ```
        }
        execution {
            sequence: 30
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: DELETE_CV
        }
    )

    process delete-section (
        name: Delete CV section
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_cv_pkg.delete_section(:P24_SECTION_ID);
                apex_util.redirect_url(apex_page.get_url(p_page => 24, p_clear_cache => '24'));
                ```
        }
        execution {
            sequence: 40
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: DELETE_SECTION
        }
    )

    process revoke-share (
        name: Revoke CV share
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_cv_pkg.revoke_share(:P24_SHARE_ID);
                apex_util.redirect_url(apex_page.get_url(p_page => 24, p_clear_cache => '24'));
                ```
        }
        execution {
            sequence: 50
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: REVOKE_SHARE
        }
    )

    process load-section (
        name: Load CV section
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for s in (select * from oan_my_cv_sections_v where id = :P24_SECTION_ID) loop
                    :P24_SECTION_VER     := s.row_version;
                    :P24_SECTION_CODE    := s.section_code;
                    :P24_SECTION_TITLE   := s.title;
                    :P24_SECTION_SORT    := s.sort_order;
                    :P24_SECTION_CONTENT := s.content;
                end loop;
                ```
        }
        execution {
            sequence: 60
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: EDIT_SECTION
        }
    )

    process upload-cv (
        name: Upload CV
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := oan_cv_pkg.upload_cv(:P24_CV);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @upload
        }
        successMessage {
            successMessage: Your CV was uploaded and is now your current CV.
        }
    )

    process keep-current (
        name: Keep current CV
        type: executeCode
        source {
            plsqlCode: oan_cv_pkg.confirm_cv;
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: KEEP_CURRENT,CONFIRM_CV
        }
        successMessage {
            successMessage: Thanks. We will ask you to check your CV again in a few months.
        }
    )

    process save-section (
        name: Save CV section
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number := :P24_SECTION_ID;
                begin
                    oan_cv_pkg.save_section(l_id, :P24_SECTION_CODE, :P24_SECTION_TITLE, :P24_SECTION_CONTENT,
                                            :P24_SECTION_SORT, :P24_SECTION_VER);
                    :P24_SECTION_ID      := null;
                    :P24_SECTION_VER     := null;
                    :P24_SECTION_TITLE   := null;
                    :P24_SECTION_CONTENT := null;
                end;
                ```
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            whenButtonPressed: @save-section
        }
        successMessage {
            successMessage: Section saved.
        }
    )

    process share-cv (
        name: Share CV
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_cv    number;
                    l_share number;
                begin
                    select id into l_cv from oan_my_cvs_v where is_current = 'Y';
                    if :P24_SHARE_MEMBER is null then
                        raise_application_error(-20400, 'Choose a connection to share with.');
                    end if;
                    l_share := oan_cv_pkg.share_cv(l_cv, to_number(:P24_SHARE_MEMBER), :P24_SHARE_PURPOSE);
                    :P24_SHARE_MEMBER  := null;
                    :P24_SHARE_PURPOSE := null;
                end;
                ```
        }
        execution {
            sequence: 40
        }
        serverSideCondition {
            whenButtonPressed: @share
        }
        successMessage {
            successMessage: Your CV was shared. They have 30 days to open it.
        }
    )

)
