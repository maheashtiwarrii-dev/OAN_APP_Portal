page 25 (
    name: Current Work Profile
    alias: WORK-PROFILE
    title: Current work profile
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack page 25 Current work profile (W2.2, R13 / B10.11). Employer and designation update the profile card. Availability and open-to are CAREER_STATUS (connections only by default, never partners). Confirm still current stamps the next review date (WORK_PROFILE_REVIEW_CADENCE_MONTHS).
    }

    region review-due (
        name: Please confirm your work profile
        type: staticContent
        source {
            htmlCode: <p>Your work profile has not been confirmed for a while. Check the details below and choose <strong>Confirm still current</strong>, or update them and save.</p>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--warning
            ]
        }
        serverSideCondition {
            type: item=value
            item: P25_REVIEW_DUE
            value: Y
        }
    )

    region work (
        name: Current work
        type: staticContent
        source {
            htmlCode: <p>Your employer and designation appear on your profile card. Who sees them follows your Work section setting on My profile.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region career-status (
        name: Career status
        type: staticContent
        source {
            htmlCode: <p>Availability and what you are open to are shown only to your connections unless you change it on My profile. They are never shown to partners.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P25_ROW_VERSION (
        type: hidden
        layout {
            sequence: 1
            region: @work
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P25_REVIEW_DUE (
        type: hidden
        layout {
            sequence: 2
            region: @work
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P25_EMPLOYMENT_STATUS (
        type: selectList
        label {
            label: Employment status
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Employed;EMPLOYED,Self-employed;SELF_EMPLOYED,Consulting;CONSULTING,Between roles;BETWEEN_ROLES,Retired;RETIRED,Studying;STUDYING
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 10
            region: @work
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P25_CURRENT_EMPLOYER (
        type: textField
        label {
            label: Current employer
        }
        layout {
            sequence: 20
            region: @work
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P25_DESIGNATION (
        type: textField
        label {
            label: Designation
        }
        layout {
            sequence: 30
            region: @work
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P25_WORK_MODE (
        type: radioGroup
        label {
            label: Work mode
        }
        lov {
            type: staticValues
            staticValues: STATIC2:On site;ONSITE,Hybrid;HYBRID,Remote;REMOTE
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @work
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P25_AVAILABILITY (
        type: radioGroup
        label {
            label: Availability
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Not looking;NOT_LOOKING,Open to opportunities;OPEN,Actively looking;ACTIVELY_LOOKING
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @career-status
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P25_NOTICE_PERIOD_DAYS (
        type: numberField
        label {
            label: Notice period (days)
        }
        settings {
            numberAlignment: start
            virtualKeyboard: numeric
        }
        layout {
            sequence: 20
            region: @career-status
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P25_OPEN_TO (
        type: selectMany
        label {
            label: Open to
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Full-time roles;FULL_TIME,Contract work;CONTRACT,Mentoring;MENTORING,Advisory roles;ADVISORY,Speaking;SPEAKING
        }
        layout {
            sequence: 30
            region: @career-status
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P25_LAST_CONFIRMED (
        type: hidden
        layout {
            sequence: 40
            region: @career-status
            slot: regionBody
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 10
            region: @career-status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirm (
        buttonName: CONFIRM
        label: Confirm still current
        layout {
            sequence: 20
            region: @career-status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back (
        buttonName: BACK
        label: Back to my profile
        layout {
            sequence: 30
            region: @career-status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 23
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load (
        name: Load work profile
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for r in (select * from oan_my_work_profile_v) loop
                    :P25_ROW_VERSION         := r.row_version;
                    :P25_REVIEW_DUE          := r.review_due;
                    :P25_EMPLOYMENT_STATUS   := r.employment_status;
                    :P25_CURRENT_EMPLOYER    := r.current_employer;
                    :P25_DESIGNATION         := r.designation;
                    :P25_WORK_MODE           := r.work_mode;
                    :P25_AVAILABILITY        := r.availability;
                    :P25_NOTICE_PERIOD_DAYS  := r.notice_period_days;
                    :P25_OPEN_TO             := r.open_to;
                    :P25_LAST_CONFIRMED      := to_char(r.last_confirmed_on, 'DD-MON-YYYY');
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save (
        name: Save work profile
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_career_pkg.save_work_profile(
                    p_employment_status  => :P25_EMPLOYMENT_STATUS,
                    p_current_employer   => :P25_CURRENT_EMPLOYER,
                    p_designation        => :P25_DESIGNATION,
                    p_work_mode          => :P25_WORK_MODE,
                    p_availability       => :P25_AVAILABILITY,
                    p_notice_period_days => :P25_NOTICE_PERIOD_DAYS,
                    p_open_to            => :P25_OPEN_TO,
                    p_row_version        => nvl(:P25_ROW_VERSION, 0));
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        successMessage {
            successMessage: Your work profile was saved.
        }
    )

    process confirm (
        name: Confirm still current
        type: executeCode
        source {
            plsqlCode: oan_career_pkg.confirm_work_profile;
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @confirm
        }
        successMessage {
            successMessage: Thanks. We will ask you to check again in a few months.
        }
    )

)
