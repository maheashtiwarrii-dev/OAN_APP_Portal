page 26 (
    name: Account Settings
    alias: ACCOUNT-SETTINGS
    title: Your account settings
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: FR-01 account management (P07): change password, change email (re-auth + confirmation at both addresses), sign-in is email and password for everyone (Q37); FR-35 directory switch and messaging permission.
    }

    region sign-in-methods (
        name: Sign-in methods
        type: staticContent
        source {
            htmlCode: <p>Linked providers: <strong>&P26_PROVIDERS.</strong></p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region change-password (
        name: Change password
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_account_v where has_local_password > 0
        }
    )

    region change-email (
        name: Change email address
        type: staticContent
        source {
            htmlCode: <p>Current email: <strong>&P26_EMAIL.</strong>. Changing it requires confirming your identity and confirming the change from both your old and new addresses.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region privacy-settings (
        name: Who can find and message you
        type: staticContent
        source {
            htmlCode: <p>These choices apply on top of each profile section's own visibility. Changes take effect immediately and are recorded.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        comments {
            comments: FR-35 directory switch, FSD FR-03 messaging permission (W2.5) and the R18 referral opt-in (1.35, default off). Saved by oan_profile_pkg.set_privacy_settings with a row-version check; each change is audited.
        }
    )

    pageItem P26_PROVIDERS (
        type: hidden
        layout {
            sequence: 10
            region: @sign-in-methods
            slot: regionBody
        }
        security {
            sessionStateProtection: restricted
        }
    )

    pageItem P26_EMAIL (
        type: hidden
        layout {
            sequence: 20
            region: @sign-in-methods
            slot: regionBody
        }
        security {
            sessionStateProtection: restricted
        }
    )

    pageItem P26_CURRENT_PASSWORD (
        type: password
        label {
            label: Current password
        }
        layout {
            sequence: 10
            region: @change-password
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
        sessionState {
            storage: request
        }
    )

    pageItem P26_NEW_PASSWORD (
        type: password
        label {
            label: New password (at least 12 characters)
        }
        layout {
            sequence: 20
            region: @change-password
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
        sessionState {
            storage: request
        }
    )

    pageItem P26_NEW_EMAIL (
        type: textField
        label {
            label: New email address
        }
        layout {
            sequence: 10
            region: @change-email
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
    )

    pageItem P26_DIRECTORY_MODE (
        type: radioGroup
        label {
            label: Who can find you in the alumni directory
        }
        lov {
            type: staticValues
            staticValues: STATIC2:All members (recommended);VISIBLE,Only my connections;CONNECTIONS,Nobody (hidden from directory and search);HIDDEN
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @privacy-settings
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P26_MESSAGING_MODE (
        type: radioGroup
        label {
            label: Who can send you messages
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Any member;ANYONE,Only my connections;CONNECTIONS,Nobody;NOBODY
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @privacy-settings
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P26_FOLLOWERS_ENABLED (
        type: switch
        label {
            label: Let members follow me
        }
        layout {
            sequence: 25
            region: @privacy-settings
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            inlineHelpText: Followers only see what your privacy settings already show them. Turning this off removes your current followers.
        }
    )

    pageItem P26_ACCEPT_REFERRALS (
        type: switch
        label {
            label: Accept referral requests
        }
        layout {
            sequence: 27
            region: @privacy-settings
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            inlineHelpText: When on, members applying to roles at your organisation may ask you for a referral (at most 5 requests a week). Off by default; when off you are never suggested.
        }
    )

    pageItem P26_PRIVACY_VERSION (
        type: hidden
        layout {
            sequence: 30
            region: @privacy-settings
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button confirm-identity (
        buttonName: CONFIRM_IDENTITY
        label: Confirm identity
        layout {
            sequence: 30
            region: @sign-in-methods
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button change-password (
        buttonName: CHANGE_PASSWORD
        label: Change password
        layout {
            sequence: 10
            region: @change-password
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button change-email (
        buttonName: CHANGE_EMAIL
        label: Send confirmation emails
        layout {
            sequence: 10
            region: @change-email
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-privacy (
        buttonName: SAVE_PRIVACY
        label: Save
        layout {
            sequence: 10
            region: @privacy-settings
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load (
        name: Load account
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for r in (select email, coalesce(linked_providers, 'none (email and password only)') providers
                            from oan_my_account_v) loop
                    :P26_EMAIL := r.email;
                    :P26_PROVIDERS := r.providers;
                end loop;
                for s in (select directory_mode, messaging_mode, followers_enabled, accept_referrals, row_version from oan_my_privacy_settings_v) loop
                    :P26_DIRECTORY_MODE  := s.directory_mode;
                    :P26_MESSAGING_MODE  := s.messaging_mode;
                    :P26_FOLLOWERS_ENABLED := s.followers_enabled;
                    :P26_ACCEPT_REFERRALS := s.accept_referrals;
                    :P26_PRIVACY_VERSION := s.row_version;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process change-password (
        name: Change password
        type: executeCode
        source {
            plsqlCode: oan_auth_pkg.change_password(:P26_CURRENT_PASSWORD, :P26_NEW_PASSWORD);
        }
        execution {
            sequence: 30
        }
        serverSideCondition {
            whenButtonPressed: @change-password
        }
        successMessage {
            successMessage: Your password was changed.
        }
    )

    process change-email (
        name: Request email change
        type: executeCode
        source {
            plsqlCode: oan_auth_pkg.request_email_change(:P26_NEW_EMAIL);
        }
        execution {
            sequence: 40
        }
        serverSideCondition {
            whenButtonPressed: @change-email
        }
        successMessage {
            successMessage: We sent confirmation links to your old and new addresses. The change completes when both are confirmed.
        }
    )

    process save-privacy (
        name: Save directory and messaging settings
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_profile_pkg.set_privacy_settings(:P26_DIRECTORY_MODE, :P26_MESSAGING_MODE, :P26_PRIVACY_VERSION);
                oan_network_pkg.set_followers_enabled(nvl(:P26_FOLLOWERS_ENABLED, 'N'));
                oan_job_pkg.set_accept_referrals(nvl(:P26_ACCEPT_REFERRALS, 'N'));
                ```
        }
        execution {
            sequence: 45
        }
        serverSideCondition {
            whenButtonPressed: @save-privacy
        }
        successMessage {
            successMessage: Your directory, messaging and follower settings were saved.
        }
    )

    process remember-return (
        name: Remember return page
        type: executeCode
        source {
            plsqlCode: :REAUTH_RETURN_PAGE := 26;
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    branch to-reauth (
        name: To identity confirmation
        behavior {
            type: pageOrUrl
            target: {
                page: 15
            }
        }
        execution {
            point: afterProcessing
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

)
