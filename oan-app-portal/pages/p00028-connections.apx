    region connections (
        name: My connections
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_id, display_name, job_title, current_org, primary_chapter, connected_at
                  from oan_my_connections_v
                 where :P28_SEARCH is null
                    or upper(display_name || ' ' || job_title || ' ' || current_org || ' ' || primary_chapter)
                       like '%' || upper(:P28_SEARCH) || '%'
                 order by display_name
                ```
