            layout {
                sequence: 3
            }
        )

        column TARGET_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Wants to meet
            }
            layout {
                sequence: 4
            }
        )

        column NOTE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 5
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Asked
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column ACCEPT_LABEL (
