            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 20
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process network-action (
        name: Networking action
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'ACCEPT'          then oan_network_pkg.accept_connection(:P28_CONNECTION_ID);
                    when 'DECLINE'         then oan_network_pkg.reject_connection(:P28_CONNECTION_ID);
                    when 'WITHDRAW'        then oan_network_pkg.withdraw_connection(:P28_CONNECTION_ID);
                    when 'REMOVE_FOLLOWER' then oan_network_pkg.remove_follower(:P28_USER_ID);
                    when 'UNFOLLOW'        then oan_network_pkg.unfollow(:P28_USER_ID);
                    when 'UNBLOCK'         then oan_network_pkg.unblock_member(:P28_USER_ID);
                    when 'ACCEPT_INTRO'    then oan_network_pkg.decide_intro(:P28_INTRO_ID, 'Y');
                    when 'DECLINE_INTRO'   then oan_network_pkg.decide_intro(:P28_INTRO_ID, 'N');
                    when 'WITHDRAW_INTRO'  then oan_network_pkg.withdraw_intro(:P28_INTRO_ID);
                    when 'DISMISS_REC'     then oan_network_pkg.dismiss_recommendation(:P28_REC_ID);
                end case;
                -- drop the request from the URL so a reload does not repeat the action
                apex_util.redirect_url(apex_page.get_url(p_page => 28));
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ACCEPT,DECLINE,WITHDRAW,REMOVE_FOLLOWER,UNFOLLOW,UNBLOCK,ACCEPT_INTRO,DECLINE_INTRO,WITHDRAW_INTRO,DISMISS_REC
        }
    )

