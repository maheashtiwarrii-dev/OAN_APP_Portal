page 28 (
    name: Connections
    alias: CONNECTIONS
    title: My network
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack page 28 Connections (FR-03, W2.8 first slice). Requests received and sent, connections (searchable), followers, following and blocked members. All rows come from viewer-scoped views; every action goes through OAN_NETWORK_PKG (members only, audited). Introductions and recommendations follow with messaging (FR-18, W4).
    }

    region r28_intro_inbox (
        name: Introductions you were asked to make
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, requester_name, requester_headline, target_name, note, created_at,
                       'Introduce' accept_label, 'Decline' decline_label
                  from oan_intro_inbox_v
                 order by created_at desc
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Nobody has asked you for an introduction.
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_intro_inbox_v
        }
        comments {
            comments: W2.8 (FR-03): accepting notifies both members; the conversation is theirs to start (page 40).
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column REQUESTER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: From
            }
            layout {
                sequence: 2
            }
        )

        column REQUESTER_HEADLINE (
            reportColumnQueryId: 3
