page 30 (
    name: Insights and Perspectives
    alias: INSIGHTS
    title: Insights and perspectives
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack W3 page 30 (FR-43 AC1/AC2). Tabs Insights (curated by content editors), Perspectives (written by alumni), Saved and My articles. Reads OAN_INSIGHTS_V / OAN_MY_SAVED_V / OAN_MY_ARTICLES_V, so Library visibility, chapter scope and blocks apply. Saving goes through OAN_INSIGHT_PKG.
    }

    region r30_tabs (
        name: Insights tabs
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_tab varchar2(20) := nvl(:P30_TAB, 'INSIGHT');
                    l_saved number;
                    function tab(p_code in varchar2, p_label in varchar2) return varchar2 is
                    begin
                        return '<a href="' || apex_page.get_url(p_page => 30, p_items => 'P30_TAB', p_values => p_code) || '"'
                            || case when l_tab = p_code then ' aria-current="page"' end || '>' || p_label || '</a>';
                    end tab;
                begin
                    select count(*) into l_saved from oan_my_saved_v;
                    return '<nav class="oan-tabs oan-tabs-wide" aria-label="Insights">'
                        || tab('INSIGHT', 'Insights') || tab('PERSPECTIVE', 'Perspectives')
                        || tab('SAVED', 'Saved' || case when l_saved > 0 then ' (' || l_saved || ')' end)
                        || tab('MINE', 'My articles') || '</nav>';
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region r30_search (
        name: Search insights
        type: staticContent
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region r30_articles (
        name: Articles
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.id, v.title, v.summary,
                       v.type_label || ' · ' || coalesce(v.author_name, 'OAN editors') || ' · '
                         || nvl(v.read_minutes, 1) || ' min read' meta,
                       nvl(v.tags, ' ') tags,
                       case when v.is_saved > 0 then 'Saved' else 'Save' end save_label,
                       v.published_at
                  from oan_insights_v v
                 where (   (nvl(:P30_TAB, 'INSIGHT') in ('INSIGHT','PERSPECTIVE') and v.content_type = nvl(:P30_TAB, 'INSIGHT'))
                        or (:P30_TAB = 'SAVED' and v.is_saved > 0))
                   and (:P30_Q is null
                        or instr(upper(v.title || ' ' || v.summary || ' ' || v.tags || ' ' || v.author_name), upper(:P30_Q)) > 0)
                 order by v.is_featured desc, v.published_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            advancedFormatting: false
            column: TITLE
        }
        subtitle {
            advancedFormatting: false
            column: META
        }
        body {
            advancedFormatting: false
            column: SUMMARY
        }
        secondaryBody {
            advancedFormatting: false
            column: TAGS
        }
        messages {
            whenNoDataFound: Nothing here yet. Save articles to read later, or write a perspective of your own.
        }
        componentAppearance {
            layout: grid
            gridColumns: 3
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: nvl(:P30_TAB, 'INSIGHT') != 'MINE'
        }

        action open-article (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 31
                    items: {
                        P31_ID: &ID.
                    }
                    clearCache: 31
                }
            }
        )

        action save (
            type: button
            label: &SAVE_LABEL.
            layout {
                sequence: 20
                position: primary
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 30
                    items: {
                        P30_SAVE_ID: &ID.
                        P30_TAB: &P30_TAB.
                    }
                    request: SAVE_TOGGLE
                }
            }
            appearance {
                displayType: text
                hot: false
            }
        )
    )

    region r30_mine (
        name: My articles
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, type_label, status_label, created_at, published_at,
                       case when status_label = 'Published' then 'Open' end open_label
                  from oan_my_articles_v
                 order by created_at desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: You have not written an article yet. Share what you have learned as a perspective.
        }
        serverSideCondition {
            type: item=value
            item: P30_TAB
            value: MINE
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Title
            }
            layout {
                sequence: 2
            }
        )

        column TYPE_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 3
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 4
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Written
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column PUBLISHED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Published
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column OPEN_LABEL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Open
            }
            layout {
                sequence: 7
            }
            link {
                target: {
                    page: 31
                    items: {
                        P31_ID: \#ID#\
                    }
                }
                linkText: #OPEN_LABEL#
            }
        )

    )

    pageItem P30_TAB (
        type: hidden
        layout {
            sequence: 10
            region: @r30_tabs
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P30_SAVE_ID (
        type: hidden
        layout {
            sequence: 20
            region: @r30_tabs
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P30_Q (
        type: textField
        label {
            label: Search titles, summaries, tags and authors
        }
        layout {
            sequence: 10
            region: @r30_search
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 5
            region: @r30_search
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button write (
        buttonName: WRITE
        label: Write a perspective
        layout {
            sequence: 10
            region: @r30_search
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                clearCache: 301
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button curate (
        buttonName: CURATE
        label: Curate an insight
        layout {
            sequence: 20
            region: @r30_search
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 301
                clearCache: 301
                items: {
                    P301_TYPE: INSIGHT
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: oan_security_pkg.authz('CONTENT_EDITOR') = 'Y'
        }
    )

    button library (
        buttonName: LIBRARY
        label: Knowledge library
        layout {
            sequence: 30
            region: @r30_search
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-toggle (
        name: Save or unsave an article
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_state varchar2(1);
                begin
                    l_state := oan_insight_pkg.toggle_save(to_number(:P30_SAVE_ID));
                    apex_util.redirect_url(apex_page.get_url(p_page => 30, p_items => 'P30_TAB', p_values => :P30_TAB));
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: SAVE_TOGGLE
        }
    )

    branch keep-tab (
        name: Keep the tab after search
        behavior {
            type: pageOrUrl
            target: {
                page: 30
                items: {
                    P30_TAB: &P30_TAB.
                    P30_Q: &P30_Q.
                }
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
