page 43 (
    name: Channel Settings
    alias: CHANNEL-SETTINGS
    title: Slack and WhatsApp
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack W4 page 43 Channel linking (FR-48, R02; journey J-21). Link Slack (send the shown code to the OAN app) or WhatsApp (a code is sent to the number), unlink, and opt in to outbound WhatsApp (off by default, re-confirmed yearly). Linking forms appear only when CHANNELS is live (gate G-CH); until then the page explains what is coming. Only masked labels are shown. All logic in OAN_CHANNEL_PKG.
    }

    region r43_status (
        name: Coming soon
        type: staticContent
        source {
            htmlCode: <p>You will soon be able to get short OAN alerts and ask OAN for help from Slack or WhatsApp. This opens once OAN's Slack app and WhatsApp Business number are approved. Meanwhile, choose which alerts you want on <a href="f?p=&APP_ID.:42:&APP_SESSION.">Notification settings</a>.</p>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--horizontal
                t-Alert--defaultIcons
                t-Alert--info
            ]
        }
        serverSideCondition {
            type: item=value
            item: P43_LIVE
            value: N
        }
    )

    region r43_linked (
        name: Your linked accounts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select channel, channel_label, status_label, external_label, linked_at,
                       case when channel = 'WHATSAPP' and status = 'LINKED'
                            then case opt_in_outbound when 'Y' then 'Yes, until ' || to_char(reverify_due_at, 'DD-MON-YYYY') else 'No' end
                       end whatsapp_alerts
                  from oan_my_channels_v
                 order by channel
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No Slack or WhatsApp account is linked.
        }

        column CHANNEL (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column CHANNEL_LABEL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Channel
            }
            layout {
                sequence: 2
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
        )

        column EXTERNAL_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Account
            }
            layout {
                sequence: 4
            }
        )

        column LINKED_AT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Linked
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column WHATSAPP_ALERTS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: WhatsApp alerts
            }
            layout {
                sequence: 6
            }
        )

    )

    region r43_slack (
        name: Slack
        type: staticContent
        source {
            htmlCode: <p>Select <strong>Get a Slack code</strong>, then send <code>link</code> followed by the code to the OAN app (&P43_SLACK_BOT.) in Slack within 15 minutes.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P43_LIVE
            value: Y
        }
    )

    region r43_whatsapp (
        name: WhatsApp
        type: staticContent
        source {
            htmlCode: <p>Enter your WhatsApp number. We send a 6-digit code to it; type the code below. OAN sends WhatsApp alerts only if you switch them on, and asks you to confirm once a year.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P43_LIVE
            value: Y
        }
    )

    region r43_deliveries (
        name: Recent alerts sent to your channels
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select channel_label, body, status_label, created_at, sent_at
                  from oan_my_channel_messages_v
                 order by created_at desc
                 fetch first 20 rows only
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Nothing sent yet.
        }

        column CHANNEL_LABEL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Channel
            }
            layout {
                sequence: 1
            }
        )

        column BODY (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Alert
            }
            layout {
                sequence: 2
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Queued
            }
            layout {
                sequence: 4
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
        )

        column SENT_AT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Sent
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD-MON-YYYY HH24:MI
            }
        )

    )

    pageItem P43_LIVE (
        type: hidden
        layout {
            sequence: 1
            region: @r43_linked
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P43_SLACK_BOT (
        type: hidden
        layout {
            sequence: 2
            region: @r43_linked
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P43_SLACK_CODE (
        type: displayOnly
        label {
            label: Your Slack code
        }
        layout {
            sequence: 10
            region: @r43_slack
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P43_SLACK_CODE
        }
    )

    pageItem P43_PHONE (
        type: textField
        label {
            label: WhatsApp number with country code
        }
        layout {
            sequence: 10
            region: @r43_whatsapp
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 20
        }
    )

    pageItem P43_CODE (
        type: textField
        label {
            label: Code from WhatsApp
        }
        layout {
            sequence: 20
            region: @r43_whatsapp
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 6
        }
    )

    pageItem P43_OPT_IN (
        type: switch
        label {
            label: Send me OAN alerts on WhatsApp
        }
        layout {
            sequence: 30
            region: @r43_whatsapp
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button slack-code (
        buttonName: SLACK_CODE
        label: Get a Slack code
        layout {
            sequence: 10
            region: @r43_slack
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button unlink-slack (
        buttonName: UNLINK_SLACK
        label: Unlink Slack
        layout {
            sequence: 20
            region: @r43_slack
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button send-code (
        buttonName: SEND_CODE
        label: Send me a code
        layout {
            sequence: 10
            region: @r43_whatsapp
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button verify (
        buttonName: VERIFY
        label: Link WhatsApp
        layout {
            sequence: 20
            region: @r43_whatsapp
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-opt-in (
        buttonName: SAVE_OPT_IN
        label: Save WhatsApp alerts
        layout {
            sequence: 30
            region: @r43_whatsapp
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button unlink-whatsapp (
        buttonName: UNLINK_WHATSAPP
        label: Unlink WhatsApp
        layout {
            sequence: 40
            region: @r43_whatsapp
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load (
        name: Load channel state
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P43_LIVE := oan_channel_pkg.channels_live;
                :P43_SLACK_BOT := oan_channel_pkg.slack_bot_handle;
                :P43_OPT_IN := 'N';
                for c in (select opt_in_outbound from oan_my_channels_v where channel = 'WHATSAPP' and status = 'LINKED') loop
                    :P43_OPT_IN := c.opt_in_outbound;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process actions (
        name: Channel actions
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_code varchar2(6);
                begin
                    if oan_channel_pkg.channels_live != 'Y' then
                        raise_application_error(-20400, 'Slack and WhatsApp are not available yet.');
                    end if;
                    case :REQUEST
                        when 'SLACK_CODE' then
                            :P43_SLACK_CODE := oan_channel_pkg.start_link('SLACK');
                        when 'UNLINK_SLACK' then
                            oan_channel_pkg.unlink('SLACK');
                        when 'SEND_CODE' then
                            l_code := oan_channel_pkg.start_link('WHATSAPP', :P43_PHONE);
                            apex_application.g_print_success_message := 'We sent a code to your WhatsApp. Type it below.';
                        when 'VERIFY' then
                            oan_channel_pkg.verify_code('WHATSAPP', :P43_CODE);
                            :P43_CODE := null;
                            apex_application.g_print_success_message := 'WhatsApp is linked.';
                        when 'SAVE_OPT_IN' then
                            oan_channel_pkg.set_opt_in(nvl(:P43_OPT_IN, 'N'));
                            apex_application.g_print_success_message := 'Saved.';
                        when 'UNLINK_WHATSAPP' then
                            oan_channel_pkg.unlink('WHATSAPP');
                    end case;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SLACK_CODE,UNLINK_SLACK,SEND_CODE,VERIFY,SAVE_OPT_IN,UNLINK_WHATSAPP
        }
    )

)
