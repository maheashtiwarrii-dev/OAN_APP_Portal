page 50 (
    name: Opportunities
    alias: OPPORTUNITIES
    title: Opportunities
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack W5 page 50 Opportunities (FR-36; journeys J-01, J-08, J-18). Oracle roles (Careers deep links), roles from verified companies (Oracle partners, customers, other companies) and member gig/contract posts, best skills match first. Filters combine with AND (AC2). Reads OAN_OPPORTUNITIES_V.
    }

    region r50_filters (
        name: Find opportunities
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region r50_jobs (
        name: Opportunities
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.id, o.title,
                       o.company_name || ' · ' || o.engagement_label || nvl2(o.where_text, ' · ' || o.where_text, '') meta,
                       substr(o.description, 1, 220) || case when length(o.description) > 220 then '...' end summary,
                       o.source_label || nvl2(o.verified_label, ' · ' || o.verified_label, '')
                         || case when o.match_pct > 0 then ' · ' || o.match_pct || '% skills match' end
                         || case when o.my_status is not null then ' · You applied' end tagline,
                       o.match_pct, o.published_at
                  from oan_opportunities_v o
                 where (:P50_Q is null
                        or instr(upper(o.title || ' ' || o.company_name || ' ' || o.skills || ' ' || o.business_area || ' ' || o.description), upper(:P50_Q)) > 0)
                   and (:P50_ENGAGEMENT is null or o.engagement_type = :P50_ENGAGEMENT)
                   and (:P50_SOURCE is null
                        or (:P50_SOURCE = 'ORACLE' and o.job_type = 'ORACLE')
                        or (:P50_SOURCE = 'COMPANY' and o.job_type in ('PARTNER','CUSTOMER','COMPANY'))
                        or (:P50_SOURCE = 'NON_ORACLE' and o.job_type in ('COMPANY','CONTRACT','GIG'))
                        or (:P50_SOURCE = 'MEMBER' and o.job_type in ('CONTRACT','GIG')))
                   and (:P50_REMOTE is null or :P50_REMOTE = 'N' or o.is_remote = 'Y')
                 order by o.match_pct desc, o.published_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            advancedFormatting: false
            column: TITLE
        }
        subtitle {
            advancedFormatting: false
            column: META
        }
        body {
            advancedFormatting: false
            column: SUMMARY
        }
        secondaryBody {
            advancedFormatting: false
            column: TAGLINE
        }
        messages {
            whenNoDataFound: No opportunities match these filters yet.
        }
        componentAppearance {
            layout: grid
            gridColumns: 3
        }

        action open-job (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 51
                    items: {
                        P51_ID: &ID.
                    }
                    clearCache: 51
                }
            }
        )
    )

    pageItem P50_Q (
        type: textField
        label {
            label: Keywords (title, company, skill)
        }
        layout {
            sequence: 10
            region: @r50_filters
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P50_ENGAGEMENT (
        type: selectList
        label {
            label: Type of work
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Full-time;FULL_TIME,Part-time;PART_TIME,Contract;CONTRACT,Gig;GIG,Internship;INTERNSHIP
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 20
            region: @r50_filters
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P50_SOURCE (
        type: selectList
        label {
            label: From
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Oracle roles;ORACLE,Companies;COMPANY,Non-Oracle companies and members;NON_ORACLE,Members (gigs, contracts);MEMBER
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 30
            region: @r50_filters
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P50_REMOTE (
        type: switch
        label {
            label: Remote only
        }
        layout {
            sequence: 40
            region: @r50_filters
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 10
            region: @r50_filters
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button post (
        buttonName: POST
        label: Post a gig or contract
        layout {
            sequence: 20
            region: @r50_filters
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 53
                clearCache: 53
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button mine (
        buttonName: MINE
        label: My applications
        layout {
            sequence: 30
            region: @r50_filters
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 52
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button skills (
        buttonName: SKILLS
        label: Skills in demand
        layout {
            sequence: 40
            region: @r50_filters
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 56
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
