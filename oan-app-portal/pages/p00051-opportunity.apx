page 51 (
    name: Opportunity
    alias: OPPORTUNITY
    title: Opportunity
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    comments {
        comments: Build Pack W5 page 51 Opportunity detail (FR-36, FR-37, R13). Members apply in-portal (non-Oracle roles) with a note and, if they choose, their current CV (an APPLICATION share for the posting organisation only); Oracle roles open Oracle Careers and record an aggregate click only (AC4). Members can ask a directory-visible member at the hiring company for a referral (5 a week). Posters and their company contacts see applicants, shortlist, decline or mark hired, and open CVs sent with applications. Notifications link here, so P51_ID is unrestricted; OAN_OPPORTUNITIES_V, OAN_JOB_APPLICANTS_V and OAN_JOB_PKG decide access.
    }

    region r51_job (
        name: Opportunity
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_html clob;
                begin
                    for o in (select * from oan_opportunities_v where id = to_number(:P51_ID)) loop
                        l_html := '<article class="oan-article"><div class="oan-article-type">' || apex_escape.html(o.source_label)
                            || case when o.verified_label is not null then ' &middot; ' || apex_escape.html(o.verified_label) end || '</div>'
                            || '<h1>' || apex_escape.html(o.title) || '</h1>'
                            || '<p class="oan-article-meta">' || apex_escape.html(o.company_name) || ' &middot; ' || apex_escape.html(o.engagement_label)
                            || case when o.where_text is not null then ' &middot; ' || apex_escape.html(o.where_text) end
                            || case when o.close_date is not null then ' &middot; closes ' || to_char(o.close_date, 'DD Mon YYYY') end || '</p>'
                            || case when o.match_pct > 0 then '<p><strong>' || o.match_pct || '% skills match</strong> with your profile</p>' end
                            || '<div class="oan-article-body"><p>' || replace(apex_escape.html(o.description), chr(10), '<br>') || '</p></div>'
                            || case when o.skills is not null then '<p><strong>Skills:</strong> ' || apex_escape.html(o.skills) || '</p>' end
                            || case when o.my_status is not null then '<p><strong>Your application:</strong> ' || initcap(o.my_status) || '</p>' end
                            || '</article>';
                    end loop;
                    return nvl(l_html, '<p>This opportunity is closed or not available.</p>');
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
    )

    region r51_apply (
        name: Apply
        type: staticContent
        source {
            htmlCode: <p>Your name, headline and note go to the poster. Your CV is sent only if you switch it on, and only to this company; withdrawing stops their access.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_opportunities_v where id = to_number(:P51_ID) and job_type != 'ORACLE' and my_status is null and is_mine = 'N'
        }
    )

    region r51_referrers (
        name: Ask for a referral
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_id, display_name, headline, current_org, 'Ask' ask_label
                  from oan_referral_candidates_v
                 where job_id = to_number(:P51_ID)
                 order by display_name
                 fetch first 10 rows only
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_opportunities_v where id = to_number(:P51_ID) and is_mine = 'N'
        }
        messages {
            whenNoDataFound: Nobody at this company is visible in the directory yet.
        }

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column DISPLAY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Member
            }
            layout {
                sequence: 2
            }
        )

        column HEADLINE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 3
            }
        )

        column CURRENT_ORG (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Organisation
            }
            layout {
                sequence: 4
            }
        )

        column ASK_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            type: link
            heading {
                heading: Referral
            }
            layout {
                sequence: 5
            }
            link {
                target: {
                    page: 51
                    items: {
                        P51_ID: &P51_ID.
                        P51_REFERRER_ID: \#USER_ID#\
                    }
                    request: ASK_REFERRAL
                }
                linkText: #ASK_LABEL#
            }
        )

    )

    region r51_applicants (
        name: Applicants
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select application_id, user_id, applicant_name, headline, cover_note, status_label, match_pct, created_at, cv_file_id,
                       case when cv_file_id is not null then 'Open CV' end cv_label,
                       case when status = 'APPLIED' then 'Shortlist' end shortlist_label,
                       case when status in ('APPLIED','SHORTLISTED') then 'Decline' end decline_label,
                       case when status = 'SHORTLISTED' then 'Hired' end hired_label
                  from oan_job_applicants_v
                 where job_id = to_number(:P51_ID)
                 order by match_pct desc, created_at
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from dual where oan_job_pkg.can_manage_job(to_number(:P51_ID)) = 'Y'
        }
        messages {
            whenNoDataFound: No applications yet.
        }

        column APPLICATION_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column USER_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column APPLICANT_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Applicant
            }
            layout {
                sequence: 3
            }
        )

        column HEADLINE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 4
            }
        )

        column COVER_NOTE (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 5
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 6
            }
        )

        column MATCH_PCT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Match %
            }
            layout {
                sequence: 7
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Applied
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column CV_FILE_ID (
            reportColumnQueryId: 9
            derivedColumn: N
            type: hidden
            layout {
                sequence: 9
            }
        )

        column CV_LABEL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: CV
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 51
                    items: {
                        P51_ID: &P51_ID.
                        P51_FILE_ID: \#CV_FILE_ID#\
                    }
                    request: DOWNLOAD
                }
                linkText: #CV_LABEL#
            }
        )

        column SHORTLIST_LABEL (
            reportColumnQueryId: 11
            derivedColumn: N
            type: link
            heading {
                heading: Shortlist
            }
            layout {
                sequence: 11
            }
            link {
                target: {
                    page: 51
                    items: {
                        P51_ID: &P51_ID.
                        P51_APP_ID: \#APPLICATION_ID#\
                    }
                    request: SHORTLISTED
                }
                linkText: #SHORTLIST_LABEL#
            }
        )

        column DECLINE_LABEL (
            reportColumnQueryId: 12
            derivedColumn: N
            type: link
            heading {
                heading: Decline
            }
            layout {
                sequence: 12
            }
            link {
                target: {
                    page: 51
                    items: {
                        P51_ID: &P51_ID.
                        P51_APP_ID: \#APPLICATION_ID#\
                    }
                    request: DECLINED
                }
                linkText: #DECLINE_LABEL#
            }
        )

        column HIRED_LABEL (
            reportColumnQueryId: 13
            derivedColumn: N
            type: link
            heading {
                heading: Hired
            }
            layout {
                sequence: 13
            }
            link {
                target: {
                    page: 51
                    items: {
                        P51_ID: &P51_ID.
                        P51_APP_ID: \#APPLICATION_ID#\
                    }
                    request: HIRED
                }
                linkText: #HIRED_LABEL#
            }
        )

    )

    pageItem P51_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r51_job
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P51_REFERRER_ID (
        type: hidden
        layout {
            sequence: 2
            region: @r51_job
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P51_APP_ID (
        type: hidden
        layout {
            sequence: 3
            region: @r51_job
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P51_FILE_ID (
        type: hidden
        layout {
            sequence: 4
            region: @r51_job
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P51_NOTE (
        type: textarea
        label {
            label: Why you are a good fit (optional)
        }
        layout {
            sequence: 10
            region: @r51_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    pageItem P51_SEND_CV (
        type: switch
        label {
            label: Send my current CV to this company
        }
        layout {
            sequence: 20
            region: @r51_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button apply (
        buttonName: APPLY
        label: Apply
        layout {
            sequence: 10
            region: @r51_apply
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button careers (
        buttonName: CAREERS
        label: Apply on Oracle Careers
        layout {
            sequence: 10
            region: @r51_job
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                items: {
                    P51_ID: &P51_ID.
                }
                request: CAREERS
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_opportunities_v where id = to_number(:P51_ID) and job_type = 'ORACLE'
        }
    )

    button withdraw (
        buttonName: WITHDRAW
        label: Withdraw my application
        layout {
            sequence: 20
            region: @r51_job
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_opportunities_v where id = to_number(:P51_ID) and my_status in ('APPLIED','SHORTLISTED')
        }
    )

    button close-job (
        buttonName: CLOSE_JOB
        label: Close this opportunity
        layout {
            sequence: 30
            region: @r51_job
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: oan_job_pkg.can_manage_job(to_number(:P51_ID)) = 'Y'
        }
    )

    button back (
        buttonName: BACK
        label: All opportunities
        layout {
            sequence: 40
            region: @r51_job
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 50
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process download-cv (
        name: Open a CV sent with an application
        type: download
        fileHandling {
            multipleFiles: false
            viewFileAs: attachment
        }
        source {
            sqlQuery:
                ```sql
                select content, filename, mime_type from oan_download_v where file_id = :P51_FILE_ID
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: DOWNLOAD
        }
    )

    process careers (
        name: Open Oracle Careers
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for o in (select apply_url from oan_opportunities_v where id = to_number(:P51_ID) and job_type = 'ORACLE') loop
                    oan_job_pkg.careers_click(to_number(:P51_ID));
                    apex_util.redirect_url(o.apply_url);
                end loop;
                ```
        }
        execution {
            sequence: 6
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: CAREERS
        }
    )

    process referral (
        name: Ask for a referral
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := oan_job_pkg.request_referral(to_number(:P51_ID), to_number(:P51_REFERRER_ID), null);
                    apex_util.redirect_url(apex_page.get_url(p_page => 54));
                end;
                ```
        }
        execution {
            sequence: 7
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: ASK_REFERRAL
        }
    )

    process applicant-status (
        name: Change an applicant's status
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_job_pkg.set_application_status(to_number(:P51_APP_ID), :REQUEST);
                apex_util.redirect_url(apex_page.get_url(p_page => 51, p_items => 'P51_ID', p_values => :P51_ID));
                ```
        }
        execution {
            sequence: 8
            point: beforeHeader
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SHORTLISTED,DECLINED,HIRED
        }
    )

    process actions (
        name: Apply, withdraw or close
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    case :REQUEST
                        when 'APPLY' then
                            l_id := oan_job_pkg.apply(to_number(:P51_ID), :P51_NOTE, nvl(:P51_SEND_CV, 'N'));
                            apex_application.g_print_success_message := 'Your application was sent. Track it under My applications.';
                        when 'WITHDRAW' then
                            select id into l_id from oan_my_applications_v where job_id = to_number(:P51_ID);
                            oan_job_pkg.withdraw(l_id);
                        when 'CLOSE_JOB' then
                            oan_job_pkg.close_job(to_number(:P51_ID));
                    end case;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPLY,WITHDRAW,CLOSE_JOB
        }
    )

    branch back (
        name: Back to the opportunity
        behavior {
            type: pageOrUrl
            target: {
                page: 51
                items: {
                    P51_ID: &P51_ID.
                }
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
