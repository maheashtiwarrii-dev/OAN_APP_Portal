page 60 (
    name: Groups
    alias: DISCUSSIONS
    title: Community groups
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: FR-41 community groups and post feed (R29: formerly Discussions/forums). Q&A, stories and announcements. Data from OAN_GROUPS_V / OAN_POSTS_V (group access and blocks applied). Group governance and the group thread page 61 arrive in W6.1 (Build Pack numbering, Q31).
    }

    region groups (
        name: Groups
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, name, description,
                       initcap(visibility) visibility,
                       post_count, to_char(last_activity, 'DD Mon YYYY') last_activity
                  from oan_groups_v
                 order by sort_order, name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No groups are available yet.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Group
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 60
                    items: {
                        P60_GROUP_ID: \#ID#\
                    }
                }
                linkText: #NAME#
            }
        )

        column DESCRIPTION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: About
            }
            layout {
                sequence: 3
            }
        )

        column VISIBILITY (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Access
            }
            layout {
                sequence: 4
            }
        )

        column POST_COUNT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Posts
            }
            layout {
                sequence: 5
            }
        )

        column LAST_ACTIVITY (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Last activity
            }
            layout {
                sequence: 6
            }
        )

    )

    region posts (
        name: Posts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, group_name,
                       case post_type when 'QUESTION' then case when accepted_comment_id is not null then 'Answered' else 'Question' end
                                      when 'STORY' then 'Story'
                                      when 'ANNOUNCEMENT' then 'Announcement' else 'Discussion' end kind,
                       author_name, comment_count, to_char(last_activity_at, 'DD Mon HH24:MI') last_activity
                  from oan_posts_v
                 where (:P60_GROUP_ID is null or group_id = :P60_GROUP_ID)
                 order by last_activity_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        reportLayout {
            numberOfRows: 25
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No posts here yet. Start the conversation with "New post".
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Post
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 62
                    items: {
                        P62_ID: \#ID#\
                    }
                }
                linkText: #TITLE#
            }
        )

        column GROUP_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Group
            }
            layout {
                sequence: 3
            }
        )

        column KIND (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 4
            }
        )

        column AUTHOR_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Posted by
            }
            layout {
                sequence: 5
            }
        )

        column COMMENT_COUNT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Comments
            }
            layout {
                sequence: 6
            }
        )

        column LAST_ACTIVITY (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Last activity
            }
            layout {
                sequence: 7
            }
        )

    )

    pageItem P60_GROUP_ID (
        type: hidden
        layout {
            sequence: 10
            region: @posts
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    button new-post (
        buttonName: NEW_POST
        label: New post
        layout {
            sequence: 10
            region: @posts
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 73
                clearCache: 73
                items: {
                    P73_GROUP_ID: &P60_GROUP_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
