page 63 (
    name: Experts
    alias: EXPERTS
    title: Experts and trainers
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W6.2 Experts (FR-07/13/21; journeys J-05, J-14). Verified experts and trainers who accept messages; Ask an expert (5 a week; accepting opens a conversation); requests to me; apply as an expert or trainer (decided by a Chapter Admin of your chapter tree or a Platform Admin, never yourself; reviewed every 24 months); decision queue for those who may decide.
    }

    region r63_experts (
        name: Experts and trainers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_id, display_name, role_label, headline, areas, years, offerings, statement, primary_chapter
                  from oan_experts_v
                 where :P63_AREA is null or instr(upper(areas), upper(:P63_AREA)) > 0
                 order by display_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No experts yet. Apply below if you can help others.
        }

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column DISPLAY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Name
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 22
                    items: {
                        P22_USER_ID: \#USER_ID#\
                    }
                }
                linkText: #DISPLAY_NAME#
            }
        )

        column ROLE_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Role
            }
            layout {
                sequence: 3
            }
        )

        column HEADLINE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 4
            }
        )

        column AREAS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Areas
            }
            layout {
                sequence: 5
            }
        )

        column YEARS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Years
            }
            layout {
                sequence: 6
            }
        )

        column OFFERINGS (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Offers
            }
            layout {
                sequence: 7
            }
        )

        column STATEMENT (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: How they help
            }
            layout {
                sequence: 8
            }
        )

        column PRIMARY_CHAPTER (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Chapter
            }
            layout {
                sequence: 9
            }
        )

    )

    region r63_ask (
        name: Ask an expert
        type: staticContent
        source {
            htmlCode: <p>Ask one expert a focused question. If they accept, a conversation opens with them.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
    )

    region r63_requests (
        name: Requests
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, case direction when 'TO_ME' then 'To me' else 'By me' end direction_label, other_name, topic, question, status_label, created_at,
                       case when direction = 'TO_ME' and status = 'OPEN' then 'Accept' end accept_label,
                       case when direction = 'TO_ME' and status = 'OPEN' then 'Decline' end decline_label
                  from oan_expert_requests_v
                 order by created_at desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_expert_requests_v
        }
        messages {
            whenNoDataFound: No requests.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column DIRECTION_LABEL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Direction
            }
            layout {
                sequence: 2
            }
        )

        column OTHER_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: With
            }
            layout {
                sequence: 3
            }
        )

        column TOPIC (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Topic
            }
            layout {
                sequence: 4
            }
        )

        column QUESTION (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Question
            }
            layout {
                sequence: 5
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 6
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Asked
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column ACCEPT_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Accept
            }
            layout {
                sequence: 8
            }
            link {
                target: {
                    page: 63
                    items: {
                        P63_REQ_ID: \#ID#\
                    }
                    request: ACCEPT_REQ
                }
                linkText: #ACCEPT_LABEL#
            }
        )

        column DECLINE_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: link
            heading {
                heading: Decline
            }
            layout {
                sequence: 9
            }
            link {
                target: {
                    page: 63
                    items: {
                        P63_REQ_ID: \#ID#\
                    }
                    request: DECLINE_REQ
                }
                linkText: #DECLINE_LABEL#
            }
        )

    )

    region r63_apply (
        name: Apply as an expert or trainer
        type: staticContent
        source {
            htmlCode: <p>Share your areas, experience and how you can help. A Chapter Admin or Platform Admin reviews it; you can never approve your own application.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
    )

