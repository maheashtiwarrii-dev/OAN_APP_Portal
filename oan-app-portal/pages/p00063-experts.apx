    pageItem P63_AREA (
        type: textField
        label {
            label: Filter by area
        }
        layout {
            sequence: 1
            region: @r63_experts
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P63_REQ_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r63_requests
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P63_APP_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r63_queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P63_EXPERT (
        type: selectList
        label {
            label: Expert
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_name || ' - ' || role_label d, user_id r from oan_experts_v order by 1
                ```
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 10
            region: @r63_ask
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P63_TOPIC (
        type: textField
        label {
            label: Topic
        }
        layout {
            sequence: 20
            region: @r63_ask
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P63_QUESTION (
        type: textarea
        label {
            label: Your question
        }
        layout {
            sequence: 30
            region: @r63_ask
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    pageItem P63_ROLE (
        type: selectList
        label {
            label: Apply as
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Expert;EXPERT,Trainer;TRAINER
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @r63_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P63_AREAS (
        type: selectMany
        label {
            label: Areas of expertise
        }
        lov {
            type: sharedComponent
            lov: @oan-skills
        }
        layout {
            sequence: 20
            region: @r63_apply
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P63_YEARS (
        type: numberField
        label {
            label: Years of experience
        }
        layout {
            sequence: 30
            region: @r63_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P63_OFFERINGS (
        type: checkboxGroup
        label {
            label: I can offer
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ask-the-expert answers;ASK_THE_EXPERT,Office hours;OFFICE_HOURS,Talks;TALKS,Reviews;REVIEWS,Training;TRAINING
            displayExtraValues: false
        }
        layout {
            sequence: 40
            region: @r63_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P63_STATEMENT (
        type: textarea
        label {
            label: How you can help
        }
        layout {
            sequence: 50
            region: @r63_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    pageItem P63_EVIDENCE (
        type: textField
        label {
            label: Evidence link (https://, optional)
        }
        layout {
            sequence: 60
            region: @r63_apply
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
    )

    button filter (
        buttonName: FILTER
        label: Filter
        layout {
            sequence: 5
            region: @r63_experts
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button ask (
        buttonName: ASK
        label: Send question
        layout {
            sequence: 10
            region: @r63_ask
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button apply (
        buttonName: APPLY
        label: Send application
        layout {
            sequence: 10
            region: @r63_apply
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button mentoring (
        buttonName: MENTORING
        label: Mentoring
        layout {
            sequence: 20
            region: @r63_experts
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 65
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process row-actions (
        name: Accept or decline a request; decide an application
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'ACCEPT_REQ'  then oan_expert_pkg.decide_request(to_number(:P63_REQ_ID), 'Y');
                    when 'DECLINE_REQ' then oan_expert_pkg.decide_request(to_number(:P63_REQ_ID), 'N');
                    when 'APPROVE_APP' then oan_expert_pkg.decide_application(to_number(:P63_APP_ID), 'APPROVE', null);
                    when 'REJECT_APP'  then oan_expert_pkg.decide_application(to_number(:P63_APP_ID), 'REJECT',
                                                'Thank you for applying. We could not verify the expertise from the details given; you are welcome to apply again with more evidence.');
                end case;
                apex_util.redirect_url(apex_page.get_url(p_page => 63));
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ACCEPT_REQ,DECLINE_REQ,APPROVE_APP,REJECT_APP
        }
    )

    process actions (
        name: Ask or apply
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    if :REQUEST = 'ASK' then
                        l_id := oan_expert_pkg.ask_expert(to_number(:P63_EXPERT), :P63_TOPIC, :P63_QUESTION);
                        :P63_TOPIC := null; :P63_QUESTION := null;
                        apex_application.g_print_success_message := 'Your question was sent.';
                    else
                        l_id := oan_expert_pkg.apply(:P63_ROLE, :P63_AREAS, to_number(:P63_YEARS), :P63_OFFERINGS, :P63_STATEMENT, :P63_EVIDENCE);
                        apex_application.g_print_success_message := 'Thanks. Your application was sent for review.';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: ASK,APPLY
        }
    )

    branch back (
        name: Back to this page
        behavior {
            type: pageOrUrl
            target: {
                page: 63
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
