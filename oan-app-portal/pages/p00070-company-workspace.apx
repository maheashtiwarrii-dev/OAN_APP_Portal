page 70 (
    name: Company Workspace
    alias: COMPANY-WORKSPACE
    title: Company workspace
    pageGroup: @organisation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-org-contact
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Build Pack W6 partner workspace landing (page 70; FR-42), first slice pulled forward on 14 Oct 2026 with company registration. Organisation page group, so the viewer runs as ORG (R01). Shows the verified organisation and its contacts. Owners invite and remove up to five colleagues (FR-20). Opportunities and applicants are on page 71; partner talent requests follow in W6.
    }

    region r70_org (
        name: Your company
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    l_html clob;
                begin
                    for o in (select * from oan_my_org_v) loop
                        l_html := '<div class="oan-dcard-top"><span class="oan-dcard-avatar oan-av-1" aria-hidden="true">'
                            || apex_escape.html(upper(substr(o.name, 1, 2))) || '</span><div>'
                            || '<div class="oan-dcard-name" style="font-size:20px">' || apex_escape.html(o.name) || '</div>'
                            || '<div class="oan-dcard-line">' || apex_escape.html(o.org_type_label)
                            || case when o.verified = 'Y' then ' &middot; Verified by OAN' end
                            || case when o.status = 'SUSPENDED' then ' &middot; Suspended' end || '</div>'
                            || case when o.website is not null then '<div class="oan-dcard-org">' || apex_escape.html(o.website) || '</div>' end
                            || '<div class="oan-dcard-loc">' || apex_escape.html(trim(o.industry || case when o.industry is not null and o.country is not null then ' &middot; ' end || o.country)) || '</div>'
                            || '</div></div>'
                            || '<p><strong>Interests:</strong> ' || apex_escape.html(nvl(o.interests, '-')) || '</p>'
                            || '<p><strong>Working with OAN members:</strong> ' || apex_escape.html(nvl(o.engagements, '-')) || '</p>'
                            || '<p><strong>Your role:</strong> ' || initcap(nvl(o.my_role, 'contact')) || '</p>';
                    end loop;
                    return l_html;
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region r70_next (
        name: What you can do with OAN
        type: staticContent
        source {
            htmlCode:
                ```html
                <ul>
                  <li><strong>Post opportunities</strong> - full-time roles, gig and contract assignments, business opportunities and collaboration requests (review by an OAN moderator first).</li>
                  <li><strong>Find talent</strong> - see member profiles that members make visible to partners, and CVs that members share with you or send with an application.</li>
                  <li><strong>Talk to members</strong> - respond to applications and introductions in Conversations.</li>
                  <li><strong>Invite colleagues</strong> - the company owner can add up to five colleagues.</li>
                </ul>
                <p>OAN never sells or exports member data. Members decide what you see, and can withdraw it at any time.</p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region r70_actions (
        name: Actions
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region r70_contacts (
        name: Company contacts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_id, contact_name, designation, role_label, added_at,
                       case when contact_role = 'CONTACT' and exists (select 1 from oan_my_org_v o where o.my_role = 'OWNER') then 'Remove' end remove_label
                  from oan_my_org_contacts_v
                 order by role_label desc, contact_name
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No contacts yet.
        }

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column CONTACT_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Name
            }
            layout {
                sequence: 2
            }
        )

        column DESIGNATION (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Designation
            }
            layout {
                sequence: 3
            }
        )

        column ROLE_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Role
            }
            layout {
                sequence: 4
            }
        )

        column ADDED_AT (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Since
            }
            layout {
                sequence: 5
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column REMOVE_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            type: link
            heading {
                heading: Remove
            }
            layout {
                sequence: 6
            }
            link {
                target: {
                    page: 70
                    items: {
                        P70_USER_ID: \#USER_ID#\
                    }
                    request: REMOVE_CONTACT
                }
                linkText: #REMOVE_LABEL#
            }
        )

    )

    region r70_invite (
        name: Invite a colleague
        type: staticContent
        source {
            htmlCode: <p>Add up to five colleagues. New people get an email link to set their password; OAN members who already have an account are added to the workspace directly.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_my_org_v where my_role = 'OWNER'
        }
    )

    pageItem P70_USER_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r70_contacts
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P70_FIRST (
        type: textField
        label {
            label: First name
        }
        layout {
            sequence: 10
            region: @r70_invite
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P70_LAST (
        type: textField
        label {
            label: Last name
        }
        layout {
            sequence: 20
            region: @r70_invite
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P70_EMAIL (
        type: textField
        label {
            label: Work email
        }
        layout {
            sequence: 30
            region: @r70_invite
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 320
        }
    )

    pageItem P70_DESIGNATION (
        type: textField
        label {
            label: Designation
        }
        layout {
            sequence: 40
            region: @r70_invite
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    button invite (
        buttonName: INVITE
        label: Send invitation
        layout {
            sequence: 10
            region: @r70_invite
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button needs (
        buttonName: NEEDS
        label: Our needs
        layout {
            sequence: 40
            region: @r70_actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 72
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process remove-contact (
        name: Remove a colleague
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_org_pkg.remove_contact(to_number(:P70_USER_ID));
                apex_util.redirect_url(apex_page.get_url(p_page => 70));
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: REMOVE_CONTACT
        }
    )

    process invite (
        name: Invite a colleague
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_org_pkg.invite_contact(:P70_FIRST, :P70_LAST, :P70_EMAIL, :P70_DESIGNATION);
                :P70_FIRST := null; :P70_LAST := null; :P70_EMAIL := null; :P70_DESIGNATION := null;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @invite
        }
        successMessage {
            successMessage: Invitation sent.
        }
    )

    button post (
        buttonName: POST
        label: Post an opportunity
        layout {
            sequence: 10
            region: @r70_actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 53
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button jobs (
        buttonName: JOBS
        label: Our opportunities and applicants
        layout {
            sequence: 20
            region: @r70_actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 71
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
