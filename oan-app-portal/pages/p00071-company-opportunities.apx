page 71 (
    name: Company Opportunities
    alias: COMPANY-OPPORTUNITIES
    title: Company opportunities
    pageGroup: @organisation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-org-contact
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: Company workspace (FR-36/FR-42; organisation page group, ORG viewer). The company's postings with review status and applicants; applicants are managed on page 51. New postings from page 53 are reviewed by an OAN moderator first.
    }

    region r71_actions (
        name: Actions
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    button post (
        buttonName: POST
        label: Post an opportunity
        layout {
            sequence: 10
            region: @r71_actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 53
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button workspace (
        buttonName: WORKSPACE
        label: Company workspace
        layout {
            sequence: 20
            region: @r71_actions
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    region r71_jobs (
        name: Our opportunities
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, status_label, review_note, applicants, published_at, close_date, 'Applicants' manage_label
                  from oan_my_jobs_v
                 order by created_at desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No opportunities yet. Post your first role, gig or business opportunity.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Opportunity
            }
            layout {
                sequence: 2
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
        )

        column REVIEW_NOTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Review note
            }
            layout {
                sequence: 4
            }
        )

        column APPLICANTS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Applicants
            }
            layout {
                sequence: 5
            }
        )

        column PUBLISHED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Published
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column CLOSE_DATE (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Closes
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column MANAGE_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Manage
            }
            layout {
                sequence: 8
            }
            link {
                target: {
                    page: 51
                    items: {
                        P51_ID: \#ID#\
                    }
                }
                linkText: #MANAGE_LABEL#
            }
        )

    )

)
