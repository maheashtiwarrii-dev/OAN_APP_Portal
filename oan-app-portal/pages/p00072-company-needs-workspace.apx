page 72 (
    name: Company Needs Workspace
    alias: COMPANY-NEEDS-WORKSPACE
    title: Our needs and responses
    pageGroup: @organisation
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        deepLinking: true
        authorizationScheme: @is-org-contact
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    comments {
        comments: W6.5 partner workspace (FR-42, R01/R07/R11; organisation page group, ORG viewer). Post a need (eleven journey types J-09..J-19; reviewed by a moderator), see responses from members (only ours), shortlist or decline, record candidate feedback (never a rating; shared with the member only when marked shareable; purged after 12 months) and close a need as filled or not pursued. Notifications link here, so P72_ID is unrestricted; OAN_ORG_NEEDS_V and OAN_TALENT_PKG decide access.
    }

    region r72_post (
        name: Post a need
        type: staticContent
        source {
            htmlCode: <p>Describe what you need from OAN members. A moderator reviews each need before members see it; members whose skills match are told.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
    )

    region r72_needs (
        name: Our needs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, type_label, status_label, status, close_label, responses, published_at,
                       case when status in ('OPEN','IN_PROGRESS') then 'Filled' end filled_label,
                       case when status in ('OPEN','IN_PROGRESS','PENDING_REVIEW') then 'Not pursued' end drop_label,
                       'Responses' open_label
                  from oan_org_needs_v
                 order by created_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No needs yet.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Need
            }
            layout {
                sequence: 2
            }
        )

        column TYPE_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 3
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 4
            }
        )

        column STATUS (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 5
            }
        )

        column CLOSE_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Closed as
            }
            layout {
                sequence: 6
            }
        )

        column RESPONSES (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Responses
            }
            layout {
                sequence: 7
            }
        )

        column PUBLISHED_AT (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Live since
            }
            layout {
                sequence: 8
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column FILLED_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: link
            heading {
                heading: Close
            }
            layout {
                sequence: 9
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_ID: \#ID#\
                    }
                    request: FILLED
                }
                linkText: #FILLED_LABEL#
            }
        )

        column DROP_LABEL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Close
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_ID: \#ID#\
                    }
                    request: NOT_PURSUED
                }
                linkText: #DROP_LABEL#
            }
        )

        column OPEN_LABEL (
            reportColumnQueryId: 11
            derivedColumn: N
            type: link
            heading {
                heading: Open
            }
            layout {
                sequence: 11
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_ID: \#ID#\
                    }
                }
                linkText: #OPEN_LABEL#
            }
        )

    )

    region r72_responses (
        name: Responses
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select response_id, member_name, headline, note, status_label, match_pct, created_at,
                       case when status = 'SENT' then 'Shortlist' end shortlist_label,
                       case when status in ('SENT','SHORTLISTED') then 'Decline' end decline_label,
                       'Feedback' feedback_label
                  from oan_org_need_responses_v
                 where request_id = to_number(:P72_ID)
                 order by match_pct desc, created_at
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P72_ID
        }
        messages {
            whenNoDataFound: No responses yet.
        }

        column RESPONSE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column MEMBER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Member
            }
            layout {
                sequence: 2
            }
        )

        column HEADLINE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 3
            }
        )

        column NOTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 4
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 5
            }
        )

        column MATCH_PCT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Match %
            }
            layout {
                sequence: 6
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Received
            }
            layout {
                sequence: 7
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column SHORTLIST_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Shortlist
            }
            layout {
                sequence: 8
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_ID: &P72_ID.
                        P72_RESP_ID: \#RESPONSE_ID#\
                    }
                    request: SHORTLISTED
                }
                linkText: #SHORTLIST_LABEL#
            }
        )

        column DECLINE_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: link
            heading {
                heading: Decline
            }
            layout {
                sequence: 9
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_ID: &P72_ID.
                        P72_RESP_ID: \#RESPONSE_ID#\
                    }
                    request: DECLINED
                }
                linkText: #DECLINE_LABEL#
            }
        )

        column FEEDBACK_LABEL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Feedback
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 72
                    items: {
                        P72_ID: &P72_ID.
                        P72_RESP_ID: \#RESPONSE_ID#\
                    }
                }
                linkText: #FEEDBACK_LABEL#
            }
        )

    )

    region r72_feedback (
        name: Candidate feedback
        type: staticContent
        source {
            htmlCode: <p>Write constructive feedback, never a score. Tick shareable to send it to the member; it is deleted after 12 months.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P72_RESP_ID
        }
    )

    pageItem P72_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r72_needs
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P72_RESP_ID (
        type: hidden
        layout {
            sequence: 2
            region: @r72_needs
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P72_TYPE (
        type: selectList
        label {
            label: What do you need?
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Talent for a role or project;TALENT,Feedback on a candidate;CANDIDATE_FEEDBACK,A partner for a bid;BID_PARTNER,Help with a problem;PROBLEM,Someone to train our team;TEAM_TRAINING,Domain experts;DOMAIN_EXPERTS,Local people for a rollout;LOCAL_ROLLOUT,Partners in a new geography;GEO_EXPANSION,People interested in our solution;SOLUTION_INTEREST,Non-Oracle partners;NON_ORACLE_PARTNERS,Funded work;FUNDED_WORK
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @r72_post
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P72_TITLE (
        type: textField
        label {
            label: Title
        }
        layout {
            sequence: 20
            region: @r72_post
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P72_DESCRIPTION (
        type: textarea
        label {
            label: Description
        }
        layout {
            sequence: 30
            region: @r72_post
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P72_SKILLS (
        type: selectMany
        label {
            label: Skills
        }
        lov {
            type: sharedComponent
            lov: @oan-skills
        }
        layout {
            sequence: 40
            region: @r72_post
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P72_LOCATION (
        type: textField
        label {
            label: Location (optional)
        }
        layout {
            sequence: 50
            region: @r72_post
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P72_LANGUAGE (
        type: textField
        label {
            label: Language (optional)
        }
        layout {
            sequence: 60
            region: @r72_post
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P72_BUDGET (
        type: selectList
        label {
            label: Budget band (funded work)
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Under 5k;UNDER_5K,5k-25k;5K_25K,25k-100k;25K_100K,Over 100k;OVER_100K
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 70
            region: @r72_post
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P72_FEEDBACK (
        type: textarea
        label {
            label: Feedback
        }
        layout {
            sequence: 10
            region: @r72_feedback
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    pageItem P72_SHAREABLE (
        type: switch
        label {
            label: Share with the member
        }
        layout {
            sequence: 20
            region: @r72_feedback
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button post (
        buttonName: POST
        label: Send for review
        layout {
            sequence: 10
            region: @r72_post
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-feedback (
        buttonName: SAVE_FEEDBACK
        label: Save feedback
        layout {
            sequence: 10
            region: @r72_feedback
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button workspace (
        buttonName: WORKSPACE
        label: Company workspace
        layout {
            sequence: 10
            region: @r72_needs
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 70
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process row-actions (
        name: Shortlist, decline or close
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'SHORTLISTED' then oan_talent_pkg.decide_response(to_number(:P72_RESP_ID), 'SHORTLISTED');
                    when 'DECLINED'    then oan_talent_pkg.decide_response(to_number(:P72_RESP_ID), 'DECLINED');
                    when 'FILLED'      then oan_talent_pkg.close_need(to_number(:P72_ID), 'FILLED');
                    when 'NOT_PURSUED' then oan_talent_pkg.close_need(to_number(:P72_ID), 'NOT_PURSUED');
                end case;
                apex_util.redirect_url(apex_page.get_url(p_page => 72, p_items => 'P72_ID', p_values => :P72_ID));
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SHORTLISTED,DECLINED,FILLED,NOT_PURSUED
        }
    )

    process actions (
        name: Post a need or save feedback
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    if :REQUEST = 'POST' then
                        l_id := oan_talent_pkg.post_need(:P72_TYPE, :P72_TITLE, :P72_DESCRIPTION, :P72_SKILLS, :P72_LOCATION, :P72_LANGUAGE, :P72_BUDGET);
                        :P72_ID := l_id; :P72_TITLE := null; :P72_DESCRIPTION := null;
                        apex_application.g_print_success_message := 'Sent for review.';
                    else
                        oan_talent_pkg.add_feedback(to_number(:P72_RESP_ID), :P72_FEEDBACK, nvl(:P72_SHAREABLE, 'N'));
                        :P72_FEEDBACK := null; :P72_RESP_ID := null;
                        apex_application.g_print_success_message := 'Feedback saved.';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: POST,SAVE_FEEDBACK
        }
    )

    branch back (
        name: Back to this page
        behavior {
            type: pageOrUrl
            target: {
                page: 72
                items: {
                    P72_ID: &P72_ID.
                }
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
