page 77 (
    name: Initiatives
    alias: INITIATIVES
    title: Initiatives
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        deepLinking: true
        authorizationScheme: @is-active
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    comments {
        comments: W6.8 Initiatives (FR-06; journeys J-04, J-07): members start community initiatives (all members or a chapter), others register interest, the owner shortlists and closes. Notifications link here, so P77_ID is unrestricted; OAN_INITIATIVES_V and OAN_COMMUNITY_PKG decide access.
    }

    region r77_list (
        name: Initiatives
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, summary, needs, owner_name, nvl(chapter_name, 'All members') audience, interested, status_label,
                       case when my_status is not null then initcap(my_status) end my_label,
                       case when is_mine = 'N' and status = 'OPEN' and nvl(my_status, 'WITHDRAWN') = 'WITHDRAWN' then 'I am interested' end interest_label,
                       case when is_mine = 'Y' then 'Manage' end manage_label,
                       case when is_mine = 'Y' and status = 'OPEN' then 'Close' end close_label
                  from oan_initiatives_v
                 order by created_at desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: No initiatives yet. Start one below.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Initiative
            }
            layout {
                sequence: 2
            }
        )

        column SUMMARY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: About
            }
            layout {
                sequence: 3
            }
        )

        column NEEDS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Needs
            }
            layout {
                sequence: 4
            }
        )

        column OWNER_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Started by
            }
            layout {
                sequence: 5
            }
        )

        column AUDIENCE (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: For
            }
            layout {
                sequence: 6
            }
        )

        column INTERESTED (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Interested
            }
            layout {
                sequence: 7
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 8
            }
        )

        column MY_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: You
            }
            layout {
                sequence: 9
            }
        )

        column INTEREST_LABEL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Join in
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 77
                    items: {
                        P77_ID: \#ID#\
                    }
                    request: INTEREST
                }
                linkText: #INTEREST_LABEL#
            }
        )

        column MANAGE_LABEL (
            reportColumnQueryId: 11
            derivedColumn: N
            type: link
            heading {
                heading: Manage
            }
            layout {
                sequence: 11
            }
            link {
                target: {
                    page: 77
                    items: {
                        P77_ID: \#ID#\
                    }
                }
                linkText: #MANAGE_LABEL#
            }
        )

        column CLOSE_LABEL (
            reportColumnQueryId: 12
            derivedColumn: N
            type: link
            heading {
                heading: Close
            }
            layout {
                sequence: 12
            }
            link {
                target: {
                    page: 77
                    items: {
                        P77_ID: \#ID#\
                    }
                    request: CLOSE
                }
                linkText: #CLOSE_LABEL#
            }
        )

    )

    region r77_interest (
        name: People interested
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_id, display_name, headline, note, status_label, created_at,
                       case when status = 'INTERESTED' then 'Shortlist' end shortlist_label,
                       case when status in ('INTERESTED','SHORTLISTED') then 'Decline' end decline_label
                  from oan_initiative_interest_v
                 where initiative_id = to_number(:P77_ID)
                 order by created_at
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_initiatives_v where id = to_number(:P77_ID) and is_mine = 'Y'
        }
        messages {
            whenNoDataFound: Nobody yet.
        }

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column DISPLAY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Member
            }
            layout {
                sequence: 2
            }
        )

        column HEADLINE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 3
            }
        )

        column NOTE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Note
            }
            layout {
                sequence: 4
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 5
            }
        )

        column CREATED_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Since
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column SHORTLIST_LABEL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Shortlist
            }
            layout {
                sequence: 7
            }
            link {
                target: {
                    page: 77
                    items: {
                        P77_ID: &P77_ID.
                        P77_USER_ID: \#USER_ID#\
                    }
                    request: SHORTLISTED
                }
                linkText: #SHORTLIST_LABEL#
            }
        )

        column DECLINE_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            type: link
            heading {
                heading: Decline
            }
            layout {
                sequence: 8
            }
            link {
                target: {
                    page: 77
                    items: {
                        P77_ID: &P77_ID.
                        P77_USER_ID: \#USER_ID#\
                    }
                    request: DECLINED
                }
                linkText: #DECLINE_LABEL#
            }
        )

    )

    region r77_start (
        name: Start an initiative
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
    )

    pageItem P77_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r77_list
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P77_USER_ID (
        type: hidden
        layout {
            sequence: 2
            region: @r77_list
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P77_TITLE (
        type: textField
        label {
            label: Title
        }
        layout {
            sequence: 10
            region: @r77_start
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P77_SUMMARY (
        type: textarea
        label {
            label: What is it about?
        }
        layout {
            sequence: 20
            region: @r77_start
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    pageItem P77_NEEDS (
        type: textField
        label {
            label: Who or what do you need?
        }
        layout {
            sequence: 30
            region: @r77_start
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P77_CHAPTER (
        type: selectList
        label {
            label: For a chapter (optional)
        }
        lov {
            type: sharedComponent
            lov: @oan-chapters
            displayNullValue: true
        }
        layout {
            sequence: 40
            region: @r77_start
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button start (
        buttonName: START
        label: Start initiative
        layout {
            sequence: 10
            region: @r77_start
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button stories (
        buttonName: STORIES
        label: Success stories
        layout {
            sequence: 10
            region: @r77_list
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 78
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process row-actions (
        name: Interest, shortlist, decline or close
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'INTEREST'    then oan_community_pkg.express_interest(to_number(:P77_ID), null);
                    when 'SHORTLISTED' then oan_community_pkg.decide_interest(to_number(:P77_ID), to_number(:P77_USER_ID), 'SHORTLISTED');
                    when 'DECLINED'    then oan_community_pkg.decide_interest(to_number(:P77_ID), to_number(:P77_USER_ID), 'DECLINED');
                    when 'CLOSE'       then oan_community_pkg.close_initiative(to_number(:P77_ID));
                end case;
                apex_util.redirect_url(apex_page.get_url(p_page => 77, p_items => 'P77_ID', p_values => :P77_ID));
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: INTEREST,SHORTLISTED,DECLINED,CLOSE
        }
    )

    process start (
        name: Start an initiative
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P77_ID := oan_community_pkg.start_initiative(:P77_TITLE, :P77_SUMMARY, :P77_NEEDS, to_number(:P77_CHAPTER));
                :P77_TITLE := null; :P77_SUMMARY := null; :P77_NEEDS := null;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @start
        }
        successMessage {
            successMessage: Your initiative is live.
        }
    )

    branch back (
        name: Back to this page
        behavior {
            type: pageOrUrl
            target: {
                page: 77
                items: {
                    P77_ID: &P77_ID.
                }
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
