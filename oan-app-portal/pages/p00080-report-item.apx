page 80 (
    name: Report Item
    alias: REPORT-ITEM
    title: Report a concern
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: true
    }
    security {
        authorizationScheme: @is-active
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.15 (FR-25, FR-19). Reached from the Report buttons on pages 22 (profile), 35 (Library item) and 62 (post). Creates a report through OAN_MODERATION_PKG.REPORT (throttled 20 per day; harassment is high priority with a 1-business-day SLA). "Remove my contribution" applies to Library items only. Links to the Community Guidelines on page 12.
    }

    region report (
        name: Report a concern
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Tell the moderators what is wrong. Your report is confidential: the member is not told who reported them.
                Read the <a href="f?p=&APP_ID.:12:&APP_SESSION.">Community Guidelines</a> for what is allowed.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P80_OBJECT_TYPE (
        type: hidden
        layout {
            sequence: 10
            region: @report
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P80_OBJECT_ID (
        type: hidden
        layout {
            sequence: 20
            region: @report
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P80_REASON (
        type: radioGroup
        label {
            label: What is the problem?
        }
        lov {
            type: sharedComponent
            lov: @oan-report-reasons
        }
        layout {
            sequence: 30
            region: @report
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P80_DETAILS (
        type: textarea
        label {
            label: Details (optional)
        }
        layout {
            sequence: 40
            region: @report
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    button send (
        buttonName: SEND
        label: Send report
        layout {
            sequence: 10
            region: @report
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @report
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process send (
        name: Create the report
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    l_id := oan_moderation_pkg.report(:P80_OBJECT_TYPE, :P80_OBJECT_ID, :P80_REASON, :P80_DETAILS);
                    :P80_REASON := null; :P80_DETAILS := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
        successMessage {
            successMessage: Thank you. Your report was sent to the moderators.
        }
    )

    branch home (
        name: Back to home
        behavior {
            type: pageOrUrl
            target: {
                page: 10
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

)
