page 101 (
    name: Create Account
    alias: CREATE-ACCOUNT
    title: Create your OAN account
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region create-account (
        name: Create your OAN account
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Prefer Google? <a href="f?p=&APP_ID.:1:&APP_SESSION.:APEX_AUTHENTICATION=OAN_GOOGLE">Continue with Google</a> instead.</p>
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
    )

    pageItem P101_FIRST_NAME (
        type: textField
        label {
            label: First name
        }
        layout {
            sequence: 10
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        sessionState {
            storage: request
        }
    )

    pageItem P101_LAST_NAME (
        type: textField
        label {
            label: Last name
        }
        layout {
            sequence: 20
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        sessionState {
            storage: request
        }
    )

    pageItem P101_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 30
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 320
        }
        sessionState {
            storage: request
        }
    )

    pageItem P101_PASSWORD (
        type: password
        label {
            label: Password (at least 12 characters)
        }
        layout {
            sequence: 40
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        sessionState {
            storage: request
        }
    )

    pageItem P101_WEBSITE (
        type: textField
        label {
            label: Leave this field empty
        }
        layout {
            sequence: 45
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            cssClasses: u-VisuallyHidden
        }
        sessionState {
            storage: request
        }
        comments {
            comments: Honeypot (ballot Q19). Bots fill it; humans never see it.
        }
    )

    pageItem P101_AGE_18 (
        type: checkbox
        label {
            label: I confirm that I am 18 years of age or older
        }
        settings {
            useDefaults: false
            checkedValue: Y
            uncheckedValue: N
        }
        layout {
            sequence: 50
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P101_ACCEPT_TERMS (
        type: checkbox
        label {
            label: I accept the Terms of Use, Privacy Notice and Community Guidelines
        }
        settings {
            useDefaults: false
            checkedValue: Y
            uncheckedValue: N
        }
        layout {
            sequence: 60
            region: @create-account
            slot: regionBody
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Read them at any time from the "Terms, Privacy &amp; Guidelines" link at the bottom of every page.
        }
        sessionState {
            storage: request
        }
    )

    button create (
        buttonName: CREATE
        label: Create account
        layout {
            sequence: 10
            region: @create-account
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--stretch
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process create-account (
        name: Create local account
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Honeypot: silently ignore automated submissions (same generic outcome)
                if :P101_WEBSITE is null then
                    oan_registration_pkg.create_local_account(
                        p_email        => :P101_EMAIL,
                        p_password     => :P101_PASSWORD,
                        p_first_name   => :P101_FIRST_NAME,
                        p_last_name    => :P101_LAST_NAME,
                        p_age_18       => :P101_AGE_18,
                        p_accept_terms => :P101_ACCEPT_TERMS);
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Check your email. If this address can be used, we have sent you a verification link (valid for 24 hours).
        }
    )

    branch to-login (
        name: To sign-in page
        behavior {
            type: pageOrUrl
            target: {
                page: 9999
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
