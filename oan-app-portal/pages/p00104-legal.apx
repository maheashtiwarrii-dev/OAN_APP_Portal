page 104 (
    name: Legal
    alias: LEGAL
    title: Terms, Privacy and Guidelines
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: GOV-03 / NFR-17 / FR-26: published legal texts (oan_terms_v is public) + privacy contact.
    }

    region documents (
        name: Terms, Privacy and Community Guidelines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select title, 'Version ' || version_no || ' - effective ' || to_char(effective_from, 'DD Mon YYYY') version_info, body
                  from oan_terms_v
                 order by decode(doc_type, 'TERMS', 1, 'PRIVACY', 2, 'GUIDELINES', 3, 'COOKIES', 4, 9)
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/value-attribute-pairs-row
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: The legal documents are being prepared.
        }

        column TITLE (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Document
            }
            layout {
                sequence: 1
            }
        )

        column VERSION_INFO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Version
            }
            layout {
                sequence: 2
            }
        )

        column BODY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Text
            }
            layout {
                sequence: 3
            }
            security {
                escapeSpecialChars: false
            }
            comments {
                comments: Legal texts are authored only by Platform Admins (page 1071) and rendered as HTML.
            }
        )

    )

    region privacy-contact (
        name: Privacy contact
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Questions, complaints or requests about your personal data (GDPR / India DPDP Act) go to the OAN privacy contact / Grievance Officer.
                Signed-in members can raise a request from their Privacy centre; we respond within 30 days.</p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)
