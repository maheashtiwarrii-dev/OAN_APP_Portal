page 114 (
    name: Approval Queue
    alias: APPROVAL-QUEUE
    title: Membership approvals
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @can-approve
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.10 (FR-01, FR-25, Q3). Applications waiting for a decision, oldest and overdue first. Platform Admins see all; Chapter Admins see their chapter tree; nobody sees their own application (OAN_APPROVAL_QUEUE_V). SLA is 3 business days.
    }

    region summary (
        name: Queue at a glance
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(*) waiting,
                       count(case when overdue = 'Y' then 1 end) overdue,
                       count(case when status = 'MORE_INFO' then 1 end) waiting_on_applicant,
                       nvl(max(age_days), 0) oldest_days
                  from oan_approval_queue_v
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/value-attribute-pairs-row
            templateOptions: #DEFAULT#
        }

        column WAITING (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Waiting
            }
            layout {
                sequence: 1
            }
        )

        column OVERDUE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Overdue (over 3 business days)
            }
            layout {
                sequence: 2
            }
        )

        column WAITING_ON_APPLICANT (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Waiting on applicant
            }
            layout {
                sequence: 3
            }
        )

        column OLDEST_DAYS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Oldest (days)
            }
            layout {
                sequence: 4
            }
        )

    )

    region queue (
        name: Applications
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select app_id,
                       applicant_name,
                       case status when 'MORE_INFO' then 'Waiting on applicant'
                                   when 'RESUBMITTED' then 'Resubmitted'
                                   else 'New' end status_label,
                       case overdue when 'Y' then 'Overdue' else 'On time' end sla,
                       to_char(submitted_at, 'DD Mon YYYY') submitted,
                       age_days,
                       coalesce(routed_to, 'Platform Admins') routed_to,
                       onboarding_intent
                  from oan_approval_queue_v
                 order by case overdue when 'Y' then 0 else 1 end, submitted_at
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No applications are waiting for you.
        }

        column APP_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column APPLICANT_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Applicant
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 115
                    clearCache: 115
                    items: {
                        P115_APP_ID: \#APP_ID#\
                    }
                }
                linkText: #APPLICANT_NAME#
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
        )

        column SLA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: SLA
            }
            layout {
                sequence: 4
            }
        )

        column SUBMITTED (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Submitted
            }
            layout {
                sequence: 5
            }
        )

        column AGE_DAYS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Age (days)
            }
            layout {
                sequence: 6
            }
        )

        column ROUTED_TO (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Routed to
            }
            layout {
                sequence: 7
            }
        )

        column ONBOARDING_INTENT (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Came for
            }
            layout {
                sequence: 8
            }
        )

    )

)
