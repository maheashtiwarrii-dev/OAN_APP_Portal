page 116 (
    name: Member Detail
    alias: MEMBER-DETAIL
    title: Member
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: true
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.11 (FR-24, NFR-01/02, R16, P08). Platform Admin actions on one member through OAN_SECURITY_PKG: grant/revoke role (re-authentication required; privileged roles need a verified email and the annual access review; never on yourself), record the access review, suspend (ends all sessions) and reactivate. Every action is audited by the package.
    }

    region member (
        name: &P116_DISPLAY_NAME.
        type: staticContent
        source {
            htmlCode:
                ```html
                <dl class="t-AVPList t-AVPList--leftAligned">
                  <dt class="t-AVPList-label">Email</dt><dd class="t-AVPList-value">&P116_EMAIL!HTML.</dd>
                  <dt class="t-AVPList-label">Status</dt><dd class="t-AVPList-value">&P116_STATUS_LABEL!HTML.</dd>
                  <dt class="t-AVPList-label">Roles</dt><dd class="t-AVPList-value">&P116_ROLES!HTML.</dd>
                  <dt class="t-AVPList-label">Sign-in methods</dt><dd class="t-AVPList-value">&P116_SIGN_IN!HTML.</dd>
                  <dt class="t-AVPList-label">Access review recorded</dt><dd class="t-AVPList-value">&P116_MFA!HTML.</dd>
                  <dt class="t-AVPList-label">Member since</dt><dd class="t-AVPList-value">&P116_CREATED!HTML.</dd>
                  <dt class="t-AVPList-label">Last sign-in</dt><dd class="t-AVPList-value">&P116_LAST_LOGIN!HTML.</dd>
                </dl>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region roles (
        name: Roles
        type: staticContent
        source {
            htmlCode: <p>Role changes need a recent identity confirmation. Administrator, Moderator, Chapter Admin and Privacy Officer need a verified email address, and you must confirm you have reviewed why they need the role. You cannot change your own roles.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region verification (
        name: Annual access review
        type: staticContent
        source {
            htmlCode: <p>Record that you have reviewed why this person still needs privileged access. Privileged roles are removed automatically 30 days after the yearly review falls due.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region account-status (
        name: Account status
        type: staticContent
        source {
            htmlCode: <p>Suspending signs the member out everywhere at once and sends them the reason you give. Reactivating restores access. A temporary password is shown to you once; give it to the member in person or by phone and ask them to change it.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P116_USER_ID (
        type: hidden
        layout {
            sequence: 10
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_DISPLAY_NAME (
        type: hidden
        layout {
            sequence: 20
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_EMAIL (
        type: hidden
        layout {
            sequence: 30
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_STATUS (
        type: hidden
        layout {
            sequence: 40
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_STATUS_LABEL (
        type: hidden
        layout {
            sequence: 50
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_ROLES (
        type: hidden
        layout {
            sequence: 60
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_SIGN_IN (
        type: hidden
        layout {
            sequence: 70
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_MFA (
        type: hidden
        layout {
            sequence: 80
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_CREATED (
        type: hidden
        layout {
            sequence: 90
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_LAST_LOGIN (
        type: hidden
        layout {
            sequence: 100
            region: @member
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P116_GRANT_ROLE (
        type: selectList
        label {
            label: Add a role
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Member;MEMBER,Expert;EXPERT,Partner contact;PARTNER,Chapter Admin;CHAPTER_ADMIN,Moderator;MODERATOR,Privacy Officer;PRIVACY_OFFICER,Platform Admin;ADMIN
        }
        layout {
            sequence: 10
            region: @roles
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P116_MFA_ATTESTED (
        type: switch
        label {
            label: I have reviewed why they need this access (required for privileged roles)
        }
        layout {
            sequence: 20
            region: @roles
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P116_REVOKE_ROLE (
        type: selectList
        label {
            label: Remove a role
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select trim(column_value) d, trim(column_value) r
                  from table(apex_string.split(:P116_ROLES, ','))
                 where trim(column_value) is not null and trim(column_value) != '-'
                ```
        }
        layout {
            sequence: 30
            region: @roles
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P116_SUSPEND_UNTIL (
        type: datePicker
        label {
            label: Suspend until (leave empty for an open-ended suspension)
        }
        layout {
            sequence: 10
            region: @account-status
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P116_SUSPEND_REASON (
        type: textarea
        label {
            label: Reason shown to the member
        }
        layout {
            sequence: 20
            region: @account-status
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    button grant (
        buttonName: GRANT
        label: Add role
        layout {
            sequence: 10
            region: @roles
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button revoke (
        buttonName: REVOKE
        label: Remove role
        layout {
            sequence: 20
            region: @roles
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Remove this role? The member is signed out everywhere and gets the new access at their next sign-in.
            style: warning
        }
    )

    button confirm-identity (
        buttonName: CONFIRM_IDENTITY
        label: Confirm my identity
        layout {
            sequence: 30
            region: @roles
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button attest (
        buttonName: ATTEST
        label: Record access review
        layout {
            sequence: 10
            region: @verification
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button temp-password (
        buttonName: TEMP_PASSWORD
        label: Issue a temporary password
        layout {
            sequence: 5
            region: @account-status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P116_STATUS
            value: ACTIVE
        }
    )

    button suspend (
        buttonName: SUSPEND
        label: Suspend member
        layout {
            sequence: 10
            region: @account-status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
            ]
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Suspend this member? They are signed out everywhere immediately.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P116_STATUS
            value: ACTIVE
        }
    )

    button reactivate (
        buttonName: REACTIVATE
        label: Reactivate member
        layout {
            sequence: 20
            region: @account-status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsInColonDelimitedList
            item: P116_STATUS
            list: SUSPENDED:DEACTIVATED
        }
    )

    button back (
        buttonName: BACK
        label: Back to members
        layout {
            sequence: 10
            region: @member
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 101
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load (
        name: Load member
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for u in (select * from oan_admin_users_v where user_id = :P116_USER_ID) loop
                    :P116_DISPLAY_NAME := u.display_name;
                    :P116_EMAIL        := u.email;
                    :P116_STATUS       := u.status;
                    :P116_STATUS_LABEL := initcap(replace(u.status, '_', ' '))
                                           || case when u.suspended_until is not null
                                                   then ' until ' || to_char(u.suspended_until, 'DD Mon YYYY') end;
                    :P116_ROLES        := coalesce(u.roles, '-');
                    :P116_SIGN_IN      := coalesce(u.idp_links, 'Email and password')
                                           || case when u.has_local_password > 0 and u.idp_links is not null then ', email and password' end;
                    :P116_MFA          := coalesce(to_char(u.mfa_attested_at, 'DD Mon YYYY'), 'Not attested');
                    :P116_CREATED      := to_char(u.created_at, 'DD Mon YYYY');
                    :P116_LAST_LOGIN   := coalesce(to_char(u.last_login_at, 'DD Mon YYYY HH24:MI'), 'Never');
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process temp-password (
        name: Issue a temporary password (Q40)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                apex_application.g_print_success_message := 'Temporary password: ' || oan_security_pkg.admin_reset_password(to_number(:P116_USER_ID))
                    || ' - shown only now. Give it to the member directly and ask them to change it on Account settings.';
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            whenButtonPressed: @temp-password
        }
    )

    process act (
        name: Apply the action
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :REQUEST
                    when 'GRANT' then
                        if not nvl(:P116_GRANT_ROLE is not null, false) then raise_application_error(-20400, 'Choose a role to add.'); end if;
                        oan_security_pkg.grant_role(:P116_USER_ID, :P116_GRANT_ROLE, nvl(:P116_MFA_ATTESTED, 'N'));
                    when 'REVOKE' then
                        if not nvl(:P116_REVOKE_ROLE is not null, false) then raise_application_error(-20400, 'Choose a role to remove.'); end if;
                        oan_security_pkg.revoke_role(:P116_USER_ID, :P116_REVOKE_ROLE);
                    when 'ATTEST' then
                        oan_security_pkg.attest_mfa(:P116_USER_ID);
                    when 'SUSPEND' then
                        if not nvl(:P116_SUSPEND_REASON is not null, false) then raise_application_error(-20400, 'Give the reason the member will see.'); end if;
                        oan_security_pkg.suspend_user(:P116_USER_ID,
                            case when :P116_SUSPEND_UNTIL is not null
                                 then to_timestamp_tz(:P116_SUSPEND_UNTIL || ' 23:59:59 UTC', 'DD-MON-YYYY HH24:MI:SS TZR') end,
                            :P116_SUSPEND_REASON);
                    when 'REACTIVATE' then
                        oan_security_pkg.reactivate_user(:P116_USER_ID);
                    else null;
                end case;
                :P116_GRANT_ROLE := null; :P116_REVOKE_ROLE := null; :P116_MFA_ATTESTED := null;
                :P116_SUSPEND_UNTIL := null; :P116_SUSPEND_REASON := null;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GRANT,REVOKE,ATTEST,SUSPEND,REACTIVATE
        }
        successMessage {
            successMessage: Done. The change is recorded in the audit log.
        }
    )

    process remember-return (
        name: Remember return page
        type: executeCode
        source {
            plsqlCode: :REAUTH_RETURN_PAGE := 116;
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    branch to-reauth (
        name: To identity confirmation
        behavior {
            type: pageOrUrl
            target: {
                page: 15
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    branch stay (
        name: Show the member again
        behavior {
            type: pageOrUrl
            target: {
                page: 116
            }
        }
        execution {
            point: afterProcessing
            sequence: 20
        }
    )

)
