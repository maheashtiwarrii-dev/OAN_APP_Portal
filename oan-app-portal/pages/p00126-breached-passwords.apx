page 126 (
    name: Breached Passwords
    alias: BREACHED-PASSWORDS
    title: Breached passwords
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.16 Breached passwords (NFR-01, Build Pack 1073). New and changed passwords are refused when their SHA-1 hash is on this list (OAN_AUTH_PKG.VALIDATE_PASSWORD_POLICY). Admins paste SHA-1 hashes (one per line, "HASH" or "HASH:count"); passwords themselves are never stored. Loading needs a recent re-authentication and is audited.
    }

    region r126_status (
        name: Breached-password list
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                return '<p><strong>' || to_char(oan_admin_pkg.breached_count, 'FM999G999G990') || '</strong> SHA-1 hashes loaded. '
                    || 'New and changed passwords that match are refused.</p>';
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region r126_load (
        name: Load hashes
        type: staticContent
        source {
            htmlCode: <p>Paste SHA-1 hashes, one per line. Lines that are not 40 hexadecimal characters are skipped; duplicates are ignored.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P126_REAUTH_OK
            value: Y
        }
    )

    pageItem P126_REAUTH_OK (
        type: hidden
        layout {
            sequence: 90
            region: @r126_status
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P126_HASHES (
        type: textarea
        label {
            label: SHA-1 hashes
        }
        layout {
            sequence: 10
            region: @r126_load
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000000
        }
    )

    button load (
        buttonName: LOAD
        label: Load
        layout {
            sequence: 10
            region: @r126_load
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button confirm-identity (
        buttonName: CONFIRM_IDENTITY
        label: Confirm my identity to make changes
        layout {
            sequence: 90
            region: @r126_status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P126_REAUTH_OK
            value: N
        }
    )

    button settings (
        buttonName: SETTINGS
        label: Settings
        layout {
            sequence: 80
            region: @r126_status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 122
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button dashboard (
        buttonName: DASHBOARD
        label: Admin dashboard
        layout {
            sequence: 81
            region: @r126_status
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 100
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process reauth-state (
        name: Re-authentication state
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P126_REAUTH_OK := case when oan_auth_pkg.is_recently_reauthenticated(5) then 'Y' else 'N' end;
                ```
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
    )

    process remember-return (
        name: Remember return page
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :REAUTH_RETURN_PAGE := 126;
                ```
        }
        execution {
            sequence: 90
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    process load (
        name: Load hashes
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_n number := oan_admin_pkg.add_breached_hashes(:P126_HASHES);
                begin
                    :P126_HASHES := null;
                    apex_application.g_print_success_message := l_n || ' new hashes loaded.';
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @load
        }
    )

    branch to-reauth (
        name: To identity confirmation
        behavior {
            type: pageOrUrl
            target: {
                page: 15
            }
        }
        execution {
            point: afterProcessing
            sequence: 5
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    branch back (
        name: Back to this page
        behavior {
            type: pageOrUrl
            target: {
                page: 126
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
