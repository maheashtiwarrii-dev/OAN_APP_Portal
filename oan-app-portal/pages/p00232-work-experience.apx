page 232 (
    name: Work Experience Entry
    alias: WORK-EXPERIENCE
    title: Experience
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W2.1 dialog from page 23: experience outside Oracle (WORK section). Saves through oan_career_pkg.
    }

    region entry (
        name: Experience
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P232_ID (
        type: hidden
        layout {
            sequence: 1
            region: @entry
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P232_ROW_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @entry
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P232_ORGANISATION (
        type: textField
        label {
            label: Organisation
        }
        layout {
            sequence: 10
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )

    pageItem P232_TITLE (
        type: textField
        label {
            label: Title
        }
        layout {
            sequence: 20
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )

    pageItem P232_START_YEAR (
        type: numberField
        label {
            label: From (year)
        }
        settings {
            numberAlignment: start
            virtualKeyboard: numeric
        }
        layout {
            sequence: 30
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P232_END_YEAR (
        type: numberField
        label {
            label: To (year)
        }
        settings {
            numberAlignment: start
            virtualKeyboard: numeric
        }
        layout {
            sequence: 40
            region: @entry
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P232_IS_CURRENT (
        type: switch
        label {
            label: I work here now
        }
        layout {
            sequence: 50
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P232_DESCRIPTION (
        type: textarea
        label {
            label: What you did (optional)
        }
        layout {
            sequence: 60
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this entry from your profile?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P232_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load (
        name: Load entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for r in (select * from oan_my_experience_v where id = :P232_ID) loop
                    :P232_ROW_VERSION := r.row_version;
                    :P232_ORGANISATION := r.organisation;
                    :P232_TITLE := r.title;
                    :P232_START_YEAR := r.start_year;
                    :P232_END_YEAR := r.end_year;
                    :P232_IS_CURRENT := r.is_current;
                    :P232_DESCRIPTION := r.description;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P232_ID
        }
    )

    process save (
        name: Save entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number := :P232_ID;
                begin
                    oan_career_pkg.save_experience(l_id, :P232_ORGANISATION, :P232_TITLE, :P232_START_YEAR, :P232_END_YEAR, :P232_IS_CURRENT, :P232_DESCRIPTION, nvl(:P232_ROW_VERSION, 0));
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process delete (
        name: Delete entry
        type: executeCode
        source {
            plsqlCode: oan_career_pkg.delete_experience(:P232_ID);
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

)