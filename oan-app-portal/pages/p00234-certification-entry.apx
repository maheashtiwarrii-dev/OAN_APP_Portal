page 234 (
    name: Certification Entry
    alias: CERTIFICATION-ENTRY
    title: Certification or achievement
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authorizationScheme: @is-signed-in
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W2.1 dialog from page 23: a certification or achievement (SKILLS section). Saves through oan_career_pkg.
    }

    region entry (
        name: Certification or achievement
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P234_ID (
        type: hidden
        layout {
            sequence: 1
            region: @entry
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P234_ROW_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @entry
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P234_KIND (
        type: radioGroup
        label {
            label: Type
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Certification;CERTIFICATION,Achievement;ACHIEVEMENT
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: CERTIFICATION
        }
    )

    pageItem P234_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 20
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 300
        }
    )

    pageItem P234_ISSUER (
        type: textField
        label {
            label: Issued by
        }
        layout {
            sequence: 30
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P234_YEAR_OBTAINED (
        type: numberField
        label {
            label: Year
        }
        settings {
            numberAlignment: start
            virtualKeyboard: numeric
        }
        layout {
            sequence: 40
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P234_EXPIRES_YEAR (
        type: numberField
        label {
            label: Expires (year)
        }
        settings {
            numberAlignment: start
            virtualKeyboard: numeric
        }
        layout {
            sequence: 50
            region: @entry
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P234_CREDENTIAL_URL (
        type: textField
        label {
            label: Credential link (https://)
        }
        layout {
            sequence: 60
            region: @entry
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Delete this entry from your profile?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P234_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process load (
        name: Load entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                for r in (select * from oan_my_certifications_v where id = :P234_ID) loop
                    :P234_ROW_VERSION := r.row_version;
                    :P234_KIND := r.kind;
                    :P234_NAME := r.name;
                    :P234_ISSUER := r.issuer;
                    :P234_YEAR_OBTAINED := r.year_obtained;
                    :P234_EXPIRES_YEAR := r.expires_year;
                    :P234_CREDENTIAL_URL := r.credential_url;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P234_ID
        }
    )

    process save (
        name: Save entry
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number := :P234_ID;
                begin
                    oan_career_pkg.save_certification(l_id, :P234_KIND, :P234_NAME, :P234_ISSUER, :P234_YEAR_OBTAINED, :P234_EXPIRES_YEAR, :P234_CREDENTIAL_URL, nvl(:P234_ROW_VERSION, 0));
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process delete (
        name: Delete entry
        type: executeCode
        source {
            plsqlCode: oan_career_pkg.delete_certification(:P234_ID);
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: false
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

)