page 791 (
    name: Organise Drive
    alias: ORGANISE-DRIVE
    title: Organise a drive, event or class
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        deepLinking: true
        authorizationScheme: @is-active
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }
    comments {
        comments: W6.10 organiser page (Q42). Propose a drive (moderators, Chapter Admins and Platform Admins publish directly; other proposals wait for a moderator), see your drives, the volunteers who signed up, record attendance and hours, close or cancel (volunteers are told). Notifications link here with P791_ID, so it is unrestricted; OAN_VOLUNTEER_ROSTER_V and OAN_VOLUNTEER_PKG check that you organise the drive.
    }

    region r791_new (
        name: Propose a drive, event or class
        type: staticContent
        source {
            htmlCode: <p>Describe what volunteers will do, where and when. Do not share anyone's personal or medical details.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: #DEFAULT#
        }
    )

    region r791_mine (
        name: My drives
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, title, cause_label, city_name, when_label, status_label, status, signed_up,
                       'Volunteers' roster_label,
                       case when status = 'OPEN' and starts_at < systimestamp then 'Close' end close_label
                  from oan_volunteer_drives_v
                 where is_mine = 'Y'
                 order by starts_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: You have not organised a drive yet.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Drive
            }
            layout {
                sequence: 2
            }
        )

        column CAUSE_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Cause
            }
            layout {
                sequence: 3
            }
        )

        column CITY_NAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: City
            }
            layout {
                sequence: 4
            }
        )

        column WHEN_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: When
            }
            layout {
                sequence: 5
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 6
            }
        )

        column STATUS (
            reportColumnQueryId: 7
            derivedColumn: N
            type: hidden
            layout {
                sequence: 7
            }
        )

        column SIGNED_UP (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Volunteers
            }
            layout {
                sequence: 8
            }
        )

        column ROSTER_LABEL (
            reportColumnQueryId: 9
            derivedColumn: N
            type: link
            heading {
                heading: Roster
            }
            layout {
                sequence: 9
            }
            link {
                target: {
                    page: 791
                    items: {
                        P791_ID: \#ID#\
                    }
                }
                linkText: #ROSTER_LABEL#
            }
        )

        column CLOSE_LABEL (
            reportColumnQueryId: 10
            derivedColumn: N
            type: link
            heading {
                heading: Close
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 791
                    items: {
                        P791_ID: \#ID#\
                    }
                    request: CLOSE
                }
                linkText: #CLOSE_LABEL#
            }
        )

    )

    region r791_roster (
        name: Volunteers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select user_id, display_name, headline, status_label, hours, signed_up_at, 'Record' record_label
                  from oan_volunteer_roster_v
                 where drive_id = to_number(:P791_ID)
                 order by signed_up_at
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P791_ID
        }
        messages {
            whenNoDataFound: Nobody has signed up yet.
        }

        column USER_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column DISPLAY_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Volunteer
            }
            layout {
                sequence: 2
            }
        )

        column HEADLINE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Headline
            }
            layout {
                sequence: 3
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 4
            }
        )

        column HOURS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Hours
            }
            layout {
                sequence: 5
            }
        )

        column SIGNED_UP_AT (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Signed up
            }
            layout {
                sequence: 6
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
        )

        column RECORD_LABEL (
            reportColumnQueryId: 7
            derivedColumn: N
            type: link
            heading {
                heading: Attendance
            }
            layout {
                sequence: 7
            }
            link {
                target: {
                    page: 791
                    items: {
                        P791_ID: &P791_ID.
                        P791_USER_ID: \#USER_ID#\
                    }
                }
                linkText: #RECORD_LABEL#
            }
        )

    )

    region r791_attend (
        name: Record attendance
        type: staticContent
        source {
            htmlCode: <p>Available once the drive has started.</p>
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P791_USER_ID
        }
    )

    region r791_cancel (
        name: Cancel this drive
        type: staticContent
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from oan_volunteer_drives_v where id = to_number(:P791_ID) and is_mine = 'Y' and status in ('OPEN','PENDING_REVIEW')
        }
    )

    pageItem P791_ID (
        type: hidden
        layout {
            sequence: 1
            region: @r791_mine
            slot: regionBody
        }
        security {
            sessionStateProtection: unrestricted
        }
    )

    pageItem P791_USER_ID (
        type: hidden
        layout {
            sequence: 2
            region: @r791_mine
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P791_CAUSE (
        type: selectList
        label {
            label: Cause or activity
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select label d, code r from oan_volunteer_causes_v order by sort_order
                ```
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 10
            region: @r791_new
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_CITY (
        type: selectList
        label {
            label: City
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d, r from oan_cities_lov_v order by d
                ```
            displayExtraValues: false
            displayNullValue: true
        }
        layout {
            sequence: 20
            region: @r791_new
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_TITLE (
        type: textField
        label {
            label: Title
        }
        layout {
            sequence: 30
            region: @r791_new
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P791_DESCRIPTION (
        type: textarea
        label {
            label: What volunteers will do
        }
        layout {
            sequence: 40
            region: @r791_new
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    pageItem P791_VENUE (
        type: textField
        label {
            label: Venue (school, village, park...)
        }
        layout {
            sequence: 50
            region: @r791_new
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 300
        }
    )

    pageItem P791_DATE (
        type: datePicker
        label {
            label: Date
        }
        layout {
            sequence: 60
            region: @r791_new
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_START (
        type: selectList
        label {
            label: Starts
        }
        lov {
            type: staticValues
            staticValues: STATIC2:06:00;0600,06:30;0630,07:00;0700,07:30;0730,08:00;0800,08:30;0830,09:00;0900,09:30;0930,10:00;1000,10:30;1030,11:00;1100,11:30;1130,12:00;1200,12:30;1230,13:00;1300,13:30;1330,14:00;1400,14:30;1430,15:00;1500,15:30;1530,16:00;1600,16:30;1630,17:00;1700,17:30;1730,18:00;1800,18:30;1830,19:00;1900,19:30;1930,20:00;2000,20:30;2030
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @r791_new
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_DURATION (
        type: selectList
        label {
            label: Duration
        }
        lov {
            type: staticValues
            staticValues: STATIC2:1 hour;1,2 hours;2,3 hours;3,4 hours;4,6 hours;6,8 hours;8
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 80
            region: @r791_new
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_CAPACITY (
        type: numberField
        label {
            label: Places (empty = no limit)
        }
        layout {
            sequence: 90
            region: @r791_new
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_ATTENDED (
        type: selectList
        label {
            label: Attended?
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Attended;Y,Did not attend;N
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @r791_attend
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_HOURS (
        type: numberField
        label {
            label: Hours given
        }
        layout {
            sequence: 20
            region: @r791_attend
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P791_REASON (
        type: textarea
        label {
            label: Reason (sent to volunteers)
        }
        layout {
            sequence: 10
            region: @r791_cancel
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 500
        }
    )

    button propose (
        buttonName: PROPOSE
        label: Publish or send for review
        layout {
            sequence: 10
            region: @r791_new
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button record (
        buttonName: RECORD
        label: Save attendance
        layout {
            sequence: 10
            region: @r791_attend
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel-drive (
        buttonName: CANCEL_DRIVE
        label: Cancel drive
        layout {
            sequence: 10
            region: @r791_cancel
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button back (
        buttonName: BACK
        label: All drives
        layout {
            sequence: 10
            region: @r791_mine
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--simple
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 79
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close (
        name: Close a drive
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                oan_volunteer_pkg.close_drive(to_number(:P791_ID));
                apex_util.redirect_url(apex_page.get_url(p_page => 791));
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: request=Value
            value: CLOSE
        }
    )

    process actions (
        name: Propose, record or cancel
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_start timestamp with time zone;
                begin
                    case :REQUEST
                        when 'PROPOSE' then
                            l_start := from_tz(cast(to_date(:P791_DATE) + (to_number(substr(:P791_START, 1, 2)) * 60 + to_number(substr(:P791_START, 3, 2))) / 1440
                                                    as timestamp), sessiontimezone);
                            :P791_ID := oan_volunteer_pkg.propose_drive(:P791_CAUSE, to_number(:P791_CITY), :P791_TITLE, :P791_DESCRIPTION, :P791_VENUE,
                                                                        l_start, l_start + numtodsinterval(to_number(:P791_DURATION), 'HOUR'),
                                                                        to_number(:P791_CAPACITY));
                            :P791_TITLE := null; :P791_DESCRIPTION := null;
                            apex_application.g_print_success_message := 'Saved. Drives from moderators and chapter admins go live at once; others are reviewed first.';
                        when 'RECORD' then
                            oan_volunteer_pkg.record_attendance(to_number(:P791_ID), to_number(:P791_USER_ID), :P791_ATTENDED, to_number(:P791_HOURS));
                            :P791_USER_ID := null;
                            apex_application.g_print_success_message := 'Attendance saved.';
                        when 'CANCEL_DRIVE' then
                            oan_volunteer_pkg.cancel_drive(to_number(:P791_ID), :P791_REASON);
                            apex_application.g_print_success_message := 'Drive cancelled. Volunteers were told.';
                    end case;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: PROPOSE,RECORD,CANCEL_DRIVE
        }
    )

    branch back (
        name: Back to this page
        behavior {
            type: pageOrUrl
            target: {
                page: 791
                items: {
                    P791_ID: &P791_ID.
                }
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
