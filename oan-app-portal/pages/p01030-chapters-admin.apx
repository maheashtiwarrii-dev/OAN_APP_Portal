page 1030 (
    name: Chapters
    alias: CHAPTERS-ADMIN
    title: Chapters
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: true
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.12 (FR-16, Q11, P11, NFR-01). Region > Country > City chapter tree (materialized path). Platform Admins create chapters and assign Chapter Admins through OAN_CHAPTER_PKG / OAN_SECURITY_PKG; Chapter Admins must sign in with Google or LinkedIn and have 2-step verification attested. Registration approvals route to the nearest ancestor chapter with an active Chapter Admin.
    }

    region tree (
        name: Chapter tree
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select lpad(' ', (length(path) - length(replace(path, '/')) - 2) * 4, chr(160)) || name chapter,
                       initcap(chapter_level) chapter_level,
                       initcap(status) status_label,
                       member_count,
                       coalesce(admins, 'None - approvals go to the parent chapter') admins
                  from oan_admin_chapters_v
                 order by path
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        reportLayout {
            numberOfRows: 500
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: No chapters yet. Create the first region below.
        }

        column CHAPTER (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Chapter
            }
            layout {
                sequence: 1
            }
        )

        column CHAPTER_LEVEL (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Level
            }
            layout {
                sequence: 2
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 3
            }
        )

        column MEMBER_COUNT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Members
            }
            layout {
                sequence: 4
            }
        )

        column ADMINS (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Chapter Admins
            }
            layout {
                sequence: 5
            }
        )

    )

    region create (
        name: Create a chapter
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region admins (
        name: Chapter Admins
        type: staticContent
        source {
            htmlCode: <p>Chapter Admins approve applications for their chapter and the chapters below it. They must sign in with Google or LinkedIn, and you must confirm you have checked their 2-step verification.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_PARENT_ID (
        type: popupLov
        label {
            label: Parent chapter (leave empty for a region)
        }
        lov {
            type: sharedComponent
            lov: @oan-chapters
        }
        layout {
            sequence: 10
            region: @create
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_LEVEL (
        type: selectList
        label {
            label: Level
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Region;REGION,Country;COUNTRY,City;CITY
        }
        layout {
            sequence: 20
            region: @create
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 30
            region: @create
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P1030_SLUG (
        type: textField
        label {
            label: Short web name (letters, numbers and hyphens)
        }
        layout {
            sequence: 40
            region: @create
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 100
        }
    )

    pageItem P1030_LOCATION_ID (
        type: popupLov
        label {
            label: Location
        }
        lov {
            type: sharedComponent
            lov: @oan-locations
        }
        layout {
            sequence: 50
            region: @create
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_DESCRIPTION (
        type: textarea
        label {
            label: Description
        }
        layout {
            sequence: 60
            region: @create
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 4000
        }
    )

    pageItem P1030_ADMIN_CHAPTER_ID (
        type: popupLov
        label {
            label: Chapter
        }
        lov {
            type: sharedComponent
            lov: @oan-chapters
        }
        layout {
            sequence: 10
            region: @admins
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_ADMIN_USER_ID (
        type: popupLov
        label {
            label: Member
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select display_name || ' (' || email || ')' d, user_id r
                  from oan_admin_users_v
                 where status = 'ACTIVE'
                 order by display_name
                ```
        }
        layout {
            sequence: 20
            region: @admins
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_MFA_ATTESTED (
        type: switch
        label {
            label: I have checked their 2-step verification
        }
        layout {
            sequence: 30
            region: @admins
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1030_REMOVE_ASSIGNMENT (
        type: selectList
        label {
            label: Remove a Chapter Admin
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select chapter_name || ': ' || admin_name d, chapter_id || ':' || user_id r
                  from oan_admin_chapter_admins_v
                 order by chapter_name, admin_name
                ```
        }
        layout {
            sequence: 40
            region: @admins
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    button create-chapter (
        buttonName: CREATE_CHAPTER
        label: Create chapter
        layout {
            sequence: 10
            region: @create
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button assign-admin (
        buttonName: ASSIGN_ADMIN
        label: Assign Chapter Admin
        layout {
            sequence: 10
            region: @admins
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button remove-admin (
        buttonName: REMOVE_ADMIN
        label: Remove Chapter Admin
        layout {
            sequence: 20
            region: @admins
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Remove this Chapter Admin? They are signed out everywhere.
            style: warning
        }
    )

    button confirm-identity (
        buttonName: CONFIRM_IDENTITY
        label: Confirm my identity
        layout {
            sequence: 30
            region: @admins
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process act (
        name: Apply the change
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    case :REQUEST
                        when 'CREATE_CHAPTER' then
                            oan_util.assert(:P1030_LEVEL is not null and trim(:P1030_NAME) is not null and trim(:P1030_SLUG) is not null,
                                            'Enter a level, a name and a short web name.');
                            oan_util.assert(regexp_like(:P1030_SLUG, '^[a-zA-Z0-9-]+$'), 'Use only letters, numbers and hyphens in the short web name.');
                            oan_util.assert((:P1030_LEVEL = 'REGION') = (:P1030_PARENT_ID is null),
                                            'A region has no parent; countries and cities need one.');
                            l_id := oan_chapter_pkg.create_chapter(:P1030_PARENT_ID, :P1030_LEVEL, trim(:P1030_NAME),
                                                                   trim(:P1030_SLUG), :P1030_LOCATION_ID, :P1030_DESCRIPTION);
                        when 'ASSIGN_ADMIN' then
                            oan_util.assert(:P1030_ADMIN_CHAPTER_ID is not null and :P1030_ADMIN_USER_ID is not null,
                                            'Choose a chapter and a member.');
                            oan_security_pkg.assign_chapter_admin(:P1030_ADMIN_CHAPTER_ID, :P1030_ADMIN_USER_ID,
                                                                  nvl(:P1030_MFA_ATTESTED, 'N'));
                        when 'REMOVE_ADMIN' then
                            oan_util.assert(:P1030_REMOVE_ASSIGNMENT is not null, 'Choose the Chapter Admin to remove.');
                            oan_security_pkg.remove_chapter_admin(
                                to_number(substr(:P1030_REMOVE_ASSIGNMENT, 1, instr(:P1030_REMOVE_ASSIGNMENT, ':') - 1)),
                                to_number(substr(:P1030_REMOVE_ASSIGNMENT, instr(:P1030_REMOVE_ASSIGNMENT, ':') + 1)));
                    end case;
                    :P1030_PARENT_ID := null; :P1030_LEVEL := null; :P1030_NAME := null; :P1030_SLUG := null;
                    :P1030_LOCATION_ID := null; :P1030_DESCRIPTION := null; :P1030_ADMIN_CHAPTER_ID := null;
                    :P1030_ADMIN_USER_ID := null; :P1030_MFA_ATTESTED := null; :P1030_REMOVE_ASSIGNMENT := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE_CHAPTER,ASSIGN_ADMIN,REMOVE_ADMIN
        }
        successMessage {
            successMessage: Saved. The change is recorded in the audit log.
        }
    )

    process remember-return (
        name: Remember return page
        type: executeCode
        source {
            plsqlCode: :REAUTH_RETURN_PAGE := 1030;
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    branch to-reauth (
        name: To identity confirmation
        behavior {
            type: pageOrUrl
            target: {
                page: 108
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @confirm-identity
        }
    )

    branch stay (
        name: Show chapters again
        behavior {
            type: pageOrUrl
            target: {
                page: 1030
            }
        }
        execution {
            point: afterProcessing
            sequence: 20
        }
    )

)
