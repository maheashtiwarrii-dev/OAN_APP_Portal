page 1040 (
    name: Taxonomy
    alias: TAXONOMY
    title: Skills, industries and topics
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: true
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @administration-rights
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.13 (FR-28, NFR-10). Platform Admin management of the controlled vocabularies through OAN_TAXONOMY_PKG: add a term, approve or reject members' suggestions (page 70), and merge duplicates. A merge re-points every profile skill, Library tag and tag follow to the surviving term and keeps the old name as a synonym (FR-28 AC1/AC2). Journey intents and onboarding roles (OAN_LU_CODES) are seeded; their live switch follows each wave close.
    }

    region filters (
        name: Find terms
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region terms (
        name: Terms
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, name,
                       initcap(replace(term_type, '_', ' ')) term_type_label,
                       case status when 'SUGGESTED' then 'Suggested - needs a decision'
                                   when 'MERGED' then 'Synonym of ' || canonical_name
                                   else initcap(status) end status_label,
                       used_by_profiles, used_by_items,
                       to_char(created_at, 'DD Mon YYYY') added
                  from oan_admin_taxonomy_v
                 where (:P1040_TYPE is null or term_type = :P1040_TYPE)
                   and (:P1040_STATUS is null or status = :P1040_STATUS)
                   and (:P1040_SEARCH is null or instr(upper(name), upper(:P1040_SEARCH)) > 0)
                 order by case status when 'SUGGESTED' then 0 else 1 end, term_type, upper(name)
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No terms match these filters.
        }

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Term
            }
            layout {
                sequence: 2
            }
            link {
                target: {
                    page: 1040
                    items: {
                        P1040_TERM_ID: \#ID#\
                    }
                }
                linkText: #NAME#
            }
        )

        column TERM_TYPE_LABEL (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Type
            }
            layout {
                sequence: 3
            }
        )

        column STATUS_LABEL (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 4
            }
        )

        column USED_BY_PROFILES (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Profiles
            }
            layout {
                sequence: 5
            }
        )

        column USED_BY_ITEMS (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Library items
            }
            layout {
                sequence: 6
            }
        )

        column ADDED (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Added
            }
            layout {
                sequence: 7
            }
        )

    )

    region manage (
        name: Manage: &P1040_TERM_NAME.
        type: staticContent
        source {
            htmlCode: <p>Approving makes a suggestion available in pickers. Merging moves every use of this term to the term you choose and keeps this name as a synonym, so searches for it still work.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsInColonDelimitedList
            item: P1040_TERM_STATUS
            list: SUGGESTED:APPROVED
        }
    )

    region add (
        name: Add a term
        type: staticContent
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1040_SEARCH (
        type: textField
        label {
            label: Name contains
        }
        layout {
            sequence: 10
            region: @filters
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    pageItem P1040_TYPE (
        type: selectList
        label {
            label: Type
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Skill;SKILL,Industry;INDUSTRY,Topic;TOPIC,Language;LANGUAGE,Experience band;EXPERIENCE_BAND
        }
        layout {
            sequence: 20
            region: @filters
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1040_STATUS (
        type: selectList
        label {
            label: Status
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Suggested;SUGGESTED,Approved;APPROVED,Merged;MERGED,Rejected;REJECTED
        }
        layout {
            sequence: 30
            region: @filters
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1040_TERM_ID (
        type: hidden
        layout {
            sequence: 10
            region: @terms
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1040_TERM_NAME (
        type: hidden
        layout {
            sequence: 20
            region: @terms
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1040_TERM_STATUS (
        type: hidden
        layout {
            sequence: 30
            region: @terms
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1040_TERM_TYPE (
        type: hidden
        layout {
            sequence: 40
            region: @terms
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1040_REJECT_REASON (
        type: textField
        label {
            label: Reason (to reject a suggestion)
        }
        layout {
            sequence: 10
            region: @manage
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 1000
        }
    )

    pageItem P1040_MERGE_INTO (
        type: popupLov
        label {
            label: Merge into
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select name d, id r
                  from oan_admin_taxonomy_v
                 where term_type = :P1040_TERM_TYPE
                   and status = 'APPROVED'
                   and id != :P1040_TERM_ID
                 order by upper(name)
                ```
        }
        layout {
            sequence: 20
            region: @manage
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1040_NEW_TYPE (
        type: selectList
        label {
            label: Type
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Skill;SKILL,Industry;INDUSTRY,Topic;TOPIC,Language;LANGUAGE,Experience band;EXPERIENCE_BAND
        }
        layout {
            sequence: 10
            region: @add
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1040_NEW_NAME (
        type: textField
        label {
            label: Name
        }
        layout {
            sequence: 20
            region: @add
            slot: regionBody
            newColumn: true
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 200
        }
    )

    button search (
        buttonName: SEARCH
        label: Search
        layout {
            sequence: 10
            region: @filters
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve suggestion
        layout {
            sequence: 10
            region: @manage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P1040_TERM_STATUS
            value: SUGGESTED
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject suggestion
        layout {
            sequence: 20
            region: @manage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: item=value
            item: P1040_TERM_STATUS
            value: SUGGESTED
        }
    )

    button merge (
        buttonName: MERGE
        label: Merge
        layout {
            sequence: 30
            region: @manage
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Merge this term? Every profile, Library item and follow that uses it moves to the term you chose. This cannot be undone here.
            style: warning
        }
    )

    button add-term (
        buttonName: ADD_TERM
        label: Add term
        layout {
            sequence: 10
            region: @add
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load (
        name: Load the selected term
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P1040_TERM_STATUS := null;
                for t in (select * from oan_admin_taxonomy_v where id = :P1040_TERM_ID) loop
                    :P1040_TERM_NAME   := t.name;
                    :P1040_TERM_STATUS := t.status;
                    :P1040_TERM_TYPE   := t.term_type;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process act (
        name: Apply the change
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_id number;
                begin
                    case :REQUEST
                        when 'APPROVE' then
                            oan_taxonomy_pkg.approve(:P1040_TERM_ID);
                        when 'REJECT' then
                            oan_util.assert(:P1040_REJECT_REASON is not null, 'Give a reason for rejecting the suggestion.');
                            oan_taxonomy_pkg.reject(:P1040_TERM_ID, :P1040_REJECT_REASON);
                        when 'MERGE' then
                            oan_util.assert(:P1040_MERGE_INTO is not null, 'Choose the term to merge into.');
                            oan_taxonomy_pkg.merge_terms(:P1040_TERM_ID, :P1040_MERGE_INTO);
                        when 'ADD_TERM' then
                            oan_util.assert(:P1040_NEW_TYPE is not null and trim(:P1040_NEW_NAME) is not null,
                                            'Choose a type and enter a name.');
                            l_id := oan_taxonomy_pkg.add_term(:P1040_NEW_TYPE, :P1040_NEW_NAME);
                    end case;
                    if :REQUEST in ('REJECT','MERGE') then
                        :P1040_TERM_ID := null;
                    end if;
                    :P1040_REJECT_REASON := null; :P1040_MERGE_INTO := null; :P1040_NEW_NAME := null;
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPROVE,REJECT,MERGE,ADD_TERM
        }
        successMessage {
            successMessage: Saved. The change is recorded in the audit log.
        }
    )

    branch stay (
        name: Show terms again
        behavior {
            type: pageOrUrl
            target: {
                page: 1040
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
