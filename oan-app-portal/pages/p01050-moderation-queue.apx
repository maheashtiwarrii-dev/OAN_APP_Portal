page 1050 (
    name: Moderation Queue
    alias: MODERATION-QUEUE
    title: Moderation queue
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @can-moderate-queue
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    comments {
        comments: W0.14 (FR-25, FR-19, Q12 hybrid moderation, P25 conflict of interest). One queue for Library pre-moderation, member reports and IP/confidentiality reports (OAN_MOD_QUEUE_V; your own items and reports naming you are filtered out). Decisions go through OAN_LIBRARY_PKG.REVIEW, OAN_MODERATION_PKG.ACT and OAN_LIBRARY_PKG.TRIAGE_IP, which audit and notify. Sales/Product and flagged Library items need a second, different Platform Admin.
    }

    region summary (
        name: Queue at a glance
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select count(*) waiting,
                       count(case when sla_due_at < systimestamp then 1 end) overdue,
                       count(case when priority = 'HIGH' then 1 end) high_priority,
                       count(case when queue_type = 'IP_REPORT' then 1 end) ip_reports
                  from oan_mod_queue_v
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/value-attribute-pairs-row
            templateOptions: #DEFAULT#
        }

        column WAITING (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Waiting
            }
            layout {
                sequence: 1
            }
        )

        column OVERDUE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Past SLA
            }
            layout {
                sequence: 2
            }
        )

        column HIGH_PRIORITY (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: High priority
            }
            layout {
                sequence: 3
            }
        )

        column IP_REPORTS (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: IP / confidentiality reports
            }
            layout {
                sequence: 4
            }
        )

    )

    region queue (
        name: Waiting for a decision
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select queue_type, object_type, object_id, report_id,
                       case queue_type when 'LIBRARY_REVIEW' then 'Library review'
                                       when 'REPORT' then 'Member report'
                                       else 'IP / confidentiality report' end queue_label,
                       coalesce(title, initcap(replace(object_type, '_', ' '))) item,
                       coalesce(reason, initcap(replace(detail_status, '_', ' '))) why,
                       case priority when 'HIGH' then 'High' else 'Normal' end priority_label,
                       to_char(received_at, 'DD Mon HH24:MI') received,
                       case when sla_due_at < systimestamp then 'Overdue' else to_char(sla_due_at, 'DD Mon HH24:MI') end due
                  from oan_mod_queue_v
                 order by case priority when 'HIGH' then 0 else 1 end, sla_due_at
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        reportLayout {
            numberOfRows: 50
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: The queue is empty.
        }

        column QUEUE_TYPE (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 1
            }
        )

        column OBJECT_TYPE (
            reportColumnQueryId: 2
            derivedColumn: N
            type: hidden
            layout {
                sequence: 2
            }
        )

        column OBJECT_ID (
            reportColumnQueryId: 3
            derivedColumn: N
            type: hidden
            layout {
                sequence: 3
            }
        )

        column REPORT_ID (
            reportColumnQueryId: 4
            derivedColumn: N
            type: hidden
            layout {
                sequence: 4
            }
        )

        column QUEUE_LABEL (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Queue
            }
            layout {
                sequence: 5
            }
        )

        column ITEM (
            reportColumnQueryId: 6
            derivedColumn: N
            type: link
            heading {
                heading: Item
            }
            layout {
                sequence: 6
            }
            link {
                target: {
                    page: 1050
                    items: {
                        P1050_QUEUE_TYPE: \#QUEUE_TYPE#\
                        P1050_OBJECT_TYPE: \#OBJECT_TYPE#\
                        P1050_OBJECT_ID: \#OBJECT_ID#\
                        P1050_REPORT_ID: \#REPORT_ID#\
                    }
                }
                linkText: #ITEM#
            }
        )

        column WHY (
            reportColumnQueryId: 7
            derivedColumn: N
            heading {
                heading: Why it is here
            }
            layout {
                sequence: 7
            }
        )

        column PRIORITY_LABEL (
            reportColumnQueryId: 8
            derivedColumn: N
            heading {
                heading: Priority
            }
            layout {
                sequence: 8
            }
        )

        column RECEIVED (
            reportColumnQueryId: 9
            derivedColumn: N
            heading {
                heading: Received
            }
            layout {
                sequence: 9
            }
        )

        column DUE (
            reportColumnQueryId: 10
            derivedColumn: N
            heading {
                heading: Due
            }
            layout {
                sequence: 10
            }
        )

    )

    region decide (
        name: Decide: &P1050_ITEM_TITLE.
        type: staticContent
        source {
            htmlCode:
                ```html
                <dl class="t-AVPList t-AVPList--leftAligned">
                  <dt class="t-AVPList-label">Queue</dt><dd class="t-AVPList-value">&P1050_QUEUE_LABEL!HTML.</dd>
                  <dt class="t-AVPList-label">Why it is here</dt><dd class="t-AVPList-value">&P1050_WHY!HTML.</dd>
                  <dt class="t-AVPList-label">Category</dt><dd class="t-AVPList-value">&P1050_CATEGORY!HTML.</dd>
                  <dt class="t-AVPList-label">Screening</dt><dd class="t-AVPList-value">&P1050_SCREENING!HTML.</dd>
                </dl>
                <p>Members are told the outcome and the reason you give. Decisions are audited. Removed content stays recoverable through an appeal.</p>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1050_ITEM_TITLE
        }
    )

    pageItem P1050_QUEUE_TYPE (
        type: hidden
        layout {
            sequence: 10
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_OBJECT_TYPE (
        type: hidden
        layout {
            sequence: 20
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_OBJECT_ID (
        type: hidden
        layout {
            sequence: 30
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_REPORT_ID (
        type: hidden
        layout {
            sequence: 40
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_ITEM_TITLE (
        type: hidden
        layout {
            sequence: 50
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_QUEUE_LABEL (
        type: hidden
        layout {
            sequence: 60
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_WHY (
        type: hidden
        layout {
            sequence: 70
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_CATEGORY (
        type: hidden
        layout {
            sequence: 80
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_SCREENING (
        type: hidden
        layout {
            sequence: 90
            region: @queue
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1050_ACTION (
        type: radioGroup
        label {
            label: Decision
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select d, r from (
                  select 'Approve and publish' d, 'APPROVE' r, 'LIBRARY_REVIEW' q, 1 s from dual union all
                  select 'Reject', 'REJECT', 'LIBRARY_REVIEW', 2 from dual union all
                  select 'Hide (reversible)', 'HIDE', 'REPORT', 1 from dual union all
                  select 'Remove', 'REMOVE', 'REPORT', 2 from dual union all
                  select 'Lock for comments (posts only)', 'LOCK', 'REPORT', 3 from dual union all
                  select 'Warn the member', 'WARN', 'REPORT', 4 from dual union all
                  select 'Dismiss the report', 'DISMISS', 'REPORT', 5 from dual union all
                  select 'Escalate to Platform Admins', 'ESCALATE', 'REPORT', 6 from dual union all
                  select 'Uphold and hide the item', 'UPHOLD', 'IP_REPORT', 1 from dual union all
                  select 'Dismiss the report', 'DISMISS', 'IP_REPORT', 2 from dual)
                 where q = :P1050_QUEUE_TYPE
                 order by s
                ```
        }
        layout {
            sequence: 10
            region: @decide
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P1050_REASON (
        type: textarea
        label {
            label: Reason shown to the member (required except to approve or dismiss)
        }
        layout {
            sequence: 20
            region: @decide
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 2000
        }
    )

    button submit-decision (
        buttonName: SUBMIT_DECISION
        label: Submit decision
        layout {
            sequence: 10
            region: @decide
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 20
            region: @decide
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1050
                clearCache: 1050
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process load (
        name: Load the selected item
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P1050_ITEM_TITLE := null;
                for q in (select * from oan_mod_queue_v
                           where queue_type = :P1050_QUEUE_TYPE
                             and object_type = :P1050_OBJECT_TYPE
                             and object_id = :P1050_OBJECT_ID
                             and (:P1050_REPORT_ID is null or report_id = :P1050_REPORT_ID)
                           fetch first 1 row only) loop
                    :P1050_ITEM_TITLE  := coalesce(q.title, initcap(replace(q.object_type, '_', ' ')));
                    :P1050_QUEUE_LABEL := case q.queue_type when 'LIBRARY_REVIEW' then 'Library review'
                                                            when 'REPORT' then 'Member report'
                                                            else 'IP / confidentiality report' end;
                    :P1050_WHY         := coalesce(q.reason, initcap(replace(q.detail_status, '_', ' ')));
                    :P1050_CATEGORY    := coalesce(initcap(replace(q.category, '_', ' ')), '-');
                    :P1050_SCREENING   := coalesce(q.screening_status, '-')
                                          || case when q.screening_hits is not null then ': ' || q.screening_hits end;
                end loop;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process decide (
        name: Record the decision
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                case :P1050_QUEUE_TYPE
                    when 'LIBRARY_REVIEW' then
                        oan_library_pkg.review(:P1050_OBJECT_ID, :P1050_ACTION, :P1050_REASON);
                    when 'REPORT' then
                        oan_moderation_pkg.act(p_object_type => :P1050_OBJECT_TYPE,
                                               p_object_id   => :P1050_OBJECT_ID,
                                               p_action      => :P1050_ACTION,
                                               p_reason      => :P1050_REASON,
                                               p_report_id   => :P1050_REPORT_ID);
                    when 'IP_REPORT' then
                        oan_library_pkg.triage_ip(:P1050_REPORT_ID,
                                                  case :P1050_ACTION when 'UPHOLD' then 'Y' else 'N' end,
                                                  :P1050_REASON);
                end case;
                :P1050_QUEUE_TYPE := null; :P1050_OBJECT_TYPE := null; :P1050_OBJECT_ID := null;
                :P1050_REPORT_ID := null; :P1050_ACTION := null; :P1050_REASON := null;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @submit-decision
        }
        successMessage {
            successMessage: Decision recorded.
        }
    )

    branch back-to-queue (
        name: Back to the queue
        behavior {
            type: pageOrUrl
            target: {
                page: 1050
            }
        }
        execution {
            point: afterProcessing
            sequence: 10
        }
    )

)
