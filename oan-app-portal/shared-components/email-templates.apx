emailTemplate OAN_GENERIC (
    name: OAN Generic Notification Email
    emailSubject: #TITLE#
    htmlFormat {
        header: <b style="font-size:20px;color:#1a5276;">OAN Portal</b>
        body:
            ```html
            <h2 style="font-size:18px;">#TITLE#</h2>
            <p>#BODY#</p>
            <p><a href="#LINK_URL#" style="background:#1a5276;color:#ffffff;padding:10px 16px;border-radius:4px;text-decoration:none;">#LINK_TEXT#</a></p>
            ```
        footer:
            ```html
            <p style="font-size:12px;color:#666;">OAN is an independent alumni community and is not affiliated with or endorsed by Oracle Corporation.</p>
            <p style="font-size:12px;color:#666;"><a href="#UNSUBSCRIBE_URL#">Unsubscribe from this type of email</a></p>
            ```
    }
    plainTextFormat {
        content:
            ```html
            #TITLE#

            #BODY#

            #LINK_TEXT#: #LINK_URL#

            OAN is an independent alumni community and is not affiliated with or endorsed by Oracle Corporation.
            Unsubscribe from this type of email: #UNSUBSCRIBE_URL#
            ```
    }
    comments {
        comments: Single template for all OAN email (oan_notify_pkg.send_email, p_template_static_id => 'OAN_GENERIC').
    }
)
