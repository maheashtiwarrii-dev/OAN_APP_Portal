list navigation-bar (
    name: Navigation Bar

    entry notifications (
        label: Notifications
        icon {
            imageIconCssClasses: fa-bell
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 41
            }
        }
        userDefinedAttributes {
            1: &AI_UNREAD_NOTIFICATIONS.
            2: oan-notif
            4: Notifications
        }
        security {
            authorizationScheme: @is-active
        }
        comments {
            comments: Build Pack §3.2 notification bell. A01 is the badge (empty when zero); oan-shell.js refreshes it every 60s.
        }
    )

    entry app-user (
        label: &APP_USER_DISPLAY.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry account-settings (
        label: Account settings
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 15
            parentEntry: @app-user
        }
        link {
            target: {
                page: 26
            }
        }
        security {
            authorizationScheme: @is-signed-in
        }
    )

    entry privacy-centre (
        label: Privacy centre
        icon {
            imageIconCssClasses: fa-user-secret
        }
        layout {
            sequence: 17
            parentEntry: @app-user
        }
        link {
            target: {
                page: 27
            }
        }
        security {
            authorizationScheme: @is-signed-in
        }
    )

    entry my-decisions (
        label: Moderation decisions
        icon {
            imageIconCssClasses: fa-gavel
        }
        layout {
            sequence: 18
            parentEntry: @app-user
        }
        link {
            target: {
                page: 81
            }
        }
        security {
            authorizationScheme: @is-active
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 10
            }
        }
        security {
            authorizationScheme: @is-active
        }
        comments {
            comments: Build Pack §3.2 left rail, destination 1 of 7.
        }
    )

    entry application-status (
        label: My application
        icon {
            imageIconCssClasses: fa-hourglass-half
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 5
            }
        }
        security {
            authorizationScheme: @is-pending
        }
    )

    entry directory (
        label: Directory
        icon {
            imageIconCssClasses: fa-address-book-o
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                20
                21
                22
            ]
        }
        link {
            target: {
                page: 20
            }
        }
        security {
            authorizationScheme: @is-active
        }
        config {
            buildOption: @w2-directory
        }
        comments {
            comments: Destination 2 of 7. Hidden until wave W2 is built (R05).
        }
    )

    entry library (
        label: Insights & Knowledge
        icon {
            imageIconCssClasses: fa-book
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: [
                34
                35
                36
            ]
        }
        link {
            target: {
                page: 34
            }
        }
        security {
            authorizationScheme: @is-active
        }
        comments {
            comments: Destination 3 of 7 (Build Pack content pages 30-36).
        }
    )

    entry messages (
        label: Messages
        icon {
            imageIconCssClasses: fa-envelope-o
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 40
            }
        }
        security {
            authorizationScheme: @is-active
        }
        config {
            buildOption: @w4-messaging
        }
        comments {
            comments: Destination 4 of 7. Hidden until wave W4 is built (R05).
        }
    )

    entry opportunities (
        label: Opportunities
        icon {
            imageIconCssClasses: fa-briefcase
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 50
            }
        }
        security {
            authorizationScheme: @is-active
        }
        config {
            buildOption: @w5-opportunities
        }
        comments {
            comments: Destination 5 of 7. Hidden until wave W5 is built (R05).
        }
    )

    entry discussions (
        label: Community
        icon {
            imageIconCssClasses: fa-comments-o
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: [
                60
                62
                73
            ]
        }
        link {
            target: {
                page: 60
            }
        }
        security {
            authorizationScheme: @is-active
        }
        comments {
            comments: Destination 6 of 7 (groups and posts).
        }
    )

    entry my-profile (
        label: My profile
        icon {
            imageIconCssClasses: fa-id-card-o
        }
        layout {
            sequence: 70
        }
        isCurrent {
            type: pages
            pages: [
                23
                26
            ]
        }
        link {
            target: {
                page: 23
            }
        }
        security {
            authorizationScheme: @is-signed-in
        }
        comments {
            comments: Destination 7 of 7.
        }
    )

    entry administration (
        label: Administration
        icon {
            imageIconCssClasses: fa-shield
        }
        layout {
            sequence: 100
        }
        link {
            target: {
                page: 100
            }
        }
        security {
            authorizationScheme: @can-moderate-queue
        }
        config {
            buildOption: @oan-admin
        }
    )

    entry approvals (
        label: Approval queue
        icon {
            imageIconCssClasses: fa-user-plus
        }
        layout {
            sequence: 110
            parentEntry: @administration
        }
        link {
            target: {
                page: 114
            }
        }
        security {
            authorizationScheme: @can-approve
        }
    )

    entry moderation (
        label: Moderation queue
        icon {
            imageIconCssClasses: fa-flag
        }
        layout {
            sequence: 120
            parentEntry: @administration
        }
        link {
            target: {
                page: 107
            }
        }
