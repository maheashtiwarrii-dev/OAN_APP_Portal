list navigation-bar (
    name: Navigation Bar

    entry notifications (
        label: Notifications
        icon {
            imageIconCssClasses: fa-bell
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 50
            }
        }
        security {
            authorizationScheme: @is-active
        }
    )

    entry app-user (
        label: &APP_USER_DISPLAY.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry account-settings (
        label: Account settings
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 15
            parentEntry: @app-user
        }
        link {
            target: {
                page: 12
            }
        }
        security {
            authorizationScheme: @is-signed-in
        }
    )

    entry privacy-centre (
        label: Privacy centre
        icon {
            imageIconCssClasses: fa-user-secret
        }
        layout {
            sequence: 17
            parentEntry: @app-user
        }
        link {
            target: {
                page: 60
            }
        }
        security {
            authorizationScheme: @is-signed-in
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
        security {
            authorizationScheme: @is-active
        }
    )

    entry application-status (
        label: My application
        icon {
            imageIconCssClasses: fa-hourglass-half
        }
        layout {
            sequence: 15
        }
        link {
            target: {
                page: 2
            }
        }
        security {
            authorizationScheme: @is-pending
        }
    )

    entry library (
