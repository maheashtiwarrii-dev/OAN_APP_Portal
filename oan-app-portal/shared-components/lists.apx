        icon {
            imageIconCssClasses: fa-upload
        }
        layout {
            sequence: 160
            parentEntry: @administration
        }
        link {
            target: {
                page: 120
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry privacy-requests (
        label: Privacy requests
        icon {
            imageIconCssClasses: fa-user-secret
        }
        layout {
            sequence: 170
            parentEntry: @administration
        }
        link {
            target: {
                page: 121
            }
        }
