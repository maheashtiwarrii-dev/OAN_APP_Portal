            sequence: 130
            parentEntry: @administration
        }
        link {
            target: {
                page: 101
            }
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    entry chapters (
        label: Chapters
        icon {
            imageIconCssClasses: fa-sitemap
        }
