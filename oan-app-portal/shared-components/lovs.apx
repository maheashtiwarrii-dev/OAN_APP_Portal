lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov oan-chapters (
    name: OAN_CHAPTERS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select d, r from oan_chapters_lov_v
            ```
    }
    columnMapping {
        display: D
        return: R
    }
)

