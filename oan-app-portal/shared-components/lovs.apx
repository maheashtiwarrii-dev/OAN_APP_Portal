lov oan-skills (
    name: OAN_SKILLS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select d, r from oan_terms_lov_v where term_type = 'SKILL' order by d
            ```
    }
    columnMapping {
        display: D
        return: R
    }
)

lov oan-tags (
    name: OAN_TAGS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select d || ' (' || initcap(term_type) || ')' d, r from oan_terms_lov_v
             where term_type in ('SKILL','TOPIC','INDUSTRY') order by d
            ```
    }
    columnMapping {
        display: D
        return: R
    }
)

lov oan-experience-bands (
    name: OAN_EXPERIENCE_BANDS
    source {
        location: localDatabase
        type: sqlQuery
        sqlQuery:
            ```sql
            select d, r from oan_terms_lov_v where term_type = 'EXPERIENCE_BAND' order by sort_order
            ```
    }
    columnMapping {
        display: D
        return: R
    }
)

