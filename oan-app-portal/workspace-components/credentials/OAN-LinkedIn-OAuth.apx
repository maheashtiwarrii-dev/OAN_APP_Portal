webCredential OAN_LinkedIn_OAuth (
    name: OAN LinkedIn OAuth
    type: oauth2ClientCredentialsFlow
    advanced {
        tokenAuthenticationMethod: clientIdAndClientSecretInBody
        promptOnInstall: true
        validForUrls: https://www.linkedin.com/oauth/,https://api.linkedin.com/
    }
    comments {
        comments: Client ID / secret are entered at install time (promptOnInstall) and never stored in git (plan 0.15, Q10).
    }
)
